-    def __init__(
-        self,
-        name: str | None,
-        context_settings: cabc.MutableMapping[str, t.Any] | None = None,
-        callback: t.Callable[..., t.Any] | None = None,
-        params: list[Parameter] | None = None,
-        help: str | None = None,
-        epilog: str | None = None,
-        short_help: str | None = None,
