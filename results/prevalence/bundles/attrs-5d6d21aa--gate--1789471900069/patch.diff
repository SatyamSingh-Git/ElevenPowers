+    def test_pipe_adapter(self):
+        """
+        pipe() correctly infers the input/output annotation of a wrapped
+        `attr.Converter` at either end, instead of the dispatch method that
+        `attr.Converter` uses internally.
+        """
+
+        def int2str(x: int, _) -> str:
+            return str(x)
+
+        def strlen(y: str, _) -> int:
+            return len(y)
+
+        assert attr.converters.pipe(
+            attr.Converter(int2str, takes_self=True), strlen
+        ).converter.__annotations__ == {"val": int, "return": int}
+        assert attr.converters.pipe(
+            int2str, attr.Converter(strlen, takes_self=True)
+        ).converter.__annotations__ == {"val": int, "return": int}
+
