diff --git a/tests/test_itsdangerous/test_timed.py b/tests/test_itsdangerous/test_timed.py
index 71ac8d9..f8e0136 100644
--- a/tests/test_itsdangerous/test_timed.py
+++ b/tests/test_itsdangerous/test_timed.py
@@ -1,3 +1,4 @@
+import hashlib
 from datetime import datetime
 from datetime import timedelta
 from functools import partial
@@ -84,3 +85,28 @@ class TestTimedSerializer(FreezeMixin, TestSerializer):
     def test_return_payload(self, serializer, value, ts):
         signed = serializer.dumps(value)
         assert serializer.loads(signed, return_timestamp=True) == (value, ts)
+
+
+def test_fallback_signers():
+    serializer = TimedSerializer(
+        secret_key="secret_key", signer_kwargs={"digest_method": hashlib.sha512}
+    )
+    signed = serializer.dumps([1, 2, 3])
+    fallback_serializer = TimedSerializer(
+        secret_key="secret_key",
+        signer_kwargs={"digest_method": hashlib.sha1},
+        fallback_signers=[{"digest_method": hashlib.sha512}],
+    )
+    assert fallback_serializer.loads(signed) == [1, 2, 3]
+
+
+def test_fallback_signers_expired():
+    serializer = TimedSerializer(
+        secret_key="secret_key", fallback_signers=[{"digest_method": hashlib.sha1}]
+    )
+
+    with freeze_time(datetime(2011, 6, 24, 0, 9, 5)):
+        signed = serializer.dumps([1, 2, 3])
+
+    with pytest.raises(SignatureExpired):
+        serializer.loads(signed, max_age=10)
