+    result = runner.invoke(inout, ["foo.txt"], input="Hey!", catch_exceptions=False)
+    assert result.output == ""
+    assert result.exit_code == 0
+    assert (tmp_path / "foo.txt").read_bytes() == b"Foo bar baz\n"
