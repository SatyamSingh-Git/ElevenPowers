+@pytest.mark.parametrize("args", ([], ["--js"], ["--xml"]))
+def test_dual_option_type_cast_value_never_gets_unset(runner, args):
+    """Options competing for the same name leave the losing one unset."""
+
+    @click.command()
+    @click.option("--js", "fmt", flag_value="js", cls=RecordingOption)
+    @click.option("--xml", "fmt", flag_value="xml", cls=RecordingOption)
+    def cli(fmt):
+        pass
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 0
+    assert all(value is not UNSET for value in cast_values(cli))
