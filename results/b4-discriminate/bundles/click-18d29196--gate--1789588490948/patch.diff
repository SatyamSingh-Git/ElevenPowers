+class TypeCastRecorder:
+    """Mixin recording all values a parameter passes to ``type_cast_value``."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.cast_values = []
+
+    def type_cast_value(self, ctx, value):
+        self.cast_values.append(value)
+        return super().type_cast_value(ctx, value)
+
+
+class RecordingOption(TypeCastRecorder, click.Option):
+    pass
+
+
+class RecordingArgument(TypeCastRecorder, click.Argument):
+    pass
+
+
+def cast_values(cli):
+    return [
+        v for p in cli.params if isinstance(p, TypeCastRecorder) for v in p.cast_values
+    ]
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "args"),
+    (
+        ({}, []),
+        ({}, ["--opt", "value"]),
+        ({"default": "d"}, []),
+        ({"default": None}, []),
+        ({"default": lambda: None}, []),
+        ({"required": True}, ["--opt", "value"]),
+        ({"type": int}, ["--opt", "1"]),
+        ({"multiple": True}, []),
+        ({"multiple": True}, ["--opt", "a", "--opt", "b"]),
+        ({"nargs": 2}, []),
+        ({"nargs": 2}, ["--opt", "a", "b"]),
+        ({"count": True}, []),
+        ({"count": True}, ["--opt", "--opt"]),
+        ({"is_flag": True}, []),
+        ({"is_flag": True}, ["--opt"]),
+        ({"is_flag": True, "default": True}, []),
+        ({"is_flag": True, "multiple": True}, []),
+        ({"flag_value": "js"}, []),
+        ({"flag_value": "js"}, ["--opt"]),
+        ({"envvar": "CLICK_TEST_UNSET_OPT"}, []),
+        ({"prompt": True}, []),
+        ({"prompt": True, "prompt_required": False}, ["--opt"]),
+    ),
+)
+def test_option_type_cast_value_never_gets_unset(runner, kwargs, args):
+    @click.command()
+    @click.option("--opt", cls=RecordingOption, **kwargs)
+    def cli(opt):
+        pass
+
+    result = runner.invoke(cli, args, input="prompted\n")
+    assert result.exit_code == 0
+    assert all(value is not UNSET for value in cast_values(cli))
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "args"),
+    (
+        ({}, ["value"]),
+        ({"required": False}, []),
+        ({"default": "d"}, []),
+        ({"type": int, "required": False}, []),
+        ({"nargs": -1}, []),
+        ({"nargs": -1}, ["a", "b"]),
+        ({"nargs": 2, "required": False}, []),
+        ({"nargs": 2}, ["a", "b"]),
+    ),
+)
+def test_argument_type_cast_value_never_gets_unset(runner, kwargs, args):
+    @click.command()
+    @click.argument("arg", cls=RecordingArgument, **kwargs)
+    def cli(arg):
+        pass
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 0
+    assert all(value is not UNSET for value in cast_values(cli))
+
