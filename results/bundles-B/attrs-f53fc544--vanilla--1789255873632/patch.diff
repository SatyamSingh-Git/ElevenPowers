+    def test_does_not_mutate_evolve(self):
+        """
+        Generating __replace__ for a class doesn't clobber attr.evolve's own
+        __module__/__qualname__/__doc__ -- it used to be assigned directly,
+        mutating the shared function object.
+        """
+        module = attr.evolve.__module__
+        qualname = attr.evolve.__qualname__
+        doc = attr.evolve.__doc__
+
+        @attr.s
+        class C:
+            x = attr.ib()
+
+        assert module == attr.evolve.__module__
+        assert qualname == attr.evolve.__qualname__
+        assert doc == attr.evolve.__doc__
+
+        # And __replace__ still works like attr.evolve.
+        inst = C(1)
+
+        assert C(42) == copy.replace(inst, x=42)
+
