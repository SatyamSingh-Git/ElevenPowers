+def test_iniconfig_strips_utf8_bom_from_file(tmp_path: Path) -> None:
+    path = tmp_path / "bom.ini"
+    path.write_bytes(b"\xef\xbb\xbf[section]\nkey = value\n")
+    config = IniConfig(str(path))
+    assert config["section"]["key"] == "value"
+
+
+def test_iniconfig_parse_strips_utf8_bom(tmp_path: Path) -> None:
+    path = tmp_path / "bom.ini"
+    path.write_bytes(b"\xef\xbb\xbf[section]\nkey = value\n")
+    config = IniConfig.parse(path)
+    assert config["section"]["key"] == "value"
