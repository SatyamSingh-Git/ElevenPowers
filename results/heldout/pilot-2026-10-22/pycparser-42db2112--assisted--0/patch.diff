+        clex = CLexer(self.error_func, on_lbrace, on_rbrace, self.type_lookup_func)
+        clex.input("hello { there } } and again }}{")
+        token_list(clex)
+        self.assertEqual(braces, ["{", "}", "}", "}", "}", "{"])
