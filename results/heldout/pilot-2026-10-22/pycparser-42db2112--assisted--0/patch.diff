+        self.assertTokensTypes("...", ["ELLIPSIS"])
+        self.assertTokensTypes("++", ["PLUSPLUS"])
+        self.assertTokensTypes("case int", ["CASE", "INT"])
+        self.assertTokensTypes("caseint", ["ID"])
