+STATUSES = '''class Status:
+    """Where a shipment is."""
+    BOOKED = "booked"
+    IN_TRANSIT = "in_transit"
+    RETURNED = "returned"
+'''
+COLUMNS = '''from ..core.status import Status
+
+COLUMNS = (("booked", "Booked"), ("in_transit", "In transit"), ("returned", "Returned"))
+'''
+
+
+def test_a_rule_kept_in_tables_outside_any_function_is_proposed(tmp_path):
+    # parcelpost's daily report kept its own table of statuses. No function held it, so it was never proposed.
+    from core.milestones.propose import propose
+    value = propose(project(tmp_path, {'app/core/status.py': STATUSES, 'app/reports/daily.py': COLUMNS}))
+    pairs = {tuple(p['files']): p for p in value['proposals']}
+    pair = pairs[('app/core/status.py', 'app/reports/daily.py')]
+    assert pair['functions'] == ['class Status', '<module>']
+    assert {'"booked"', '"in_transit"', '"returned"'} <= set(pair['shared'])
+    assert (value['coverage']['functions'], value['coverage']['bodies']) == (5, 3)
+
+
+def test_imports_and_docstrings_outside_functions_are_not_a_rule(tmp_path):
+    # Imports are the import graph, which briefs already name; a docstring is prose.
+    from core.milestones.propose import propose
+    both = '"""Totals for the quarterly ledger export."""\nfrom .ledger import reconcile_quarter, LEDGER_EPOCH\n'
+    value = propose(project(tmp_path, {'app/one.py': both, 'app/two.py': both}))
+    assert not [p for p in value['proposals'] if 'app/one.py' in p['files']]
+
+
+def test_a_proposal_names_the_method_that_keeps_the_rule_not_its_class(tmp_path):
+    from core.milestones.propose import propose
+    # Its methods keep half the rule each. Taken as one, the class would share more with closing than either.
+    ledger = ('class Ledger:\n    def close(self):\n        return self.book.settle(settle_rate)\n\n'
+              '    def reopen(self):\n        return self.book.extend(grace_days)\n')
+    closing = 'def closing(book):\n    return book.settle(settle_rate), book.extend(grace_days)\n'
+    value = propose(project(tmp_path, {'app/ledger.py': ledger, 'app/closing.py': closing}))
+    pair = next(p for p in value['proposals'] if p['files'] == ['app/closing.py', 'app/ledger.py'])
+    assert pair['functions'][1] in ('close', 'reopen')
+
+
+def test_each_body_keeps_only_its_own_statements():
+    # Lone carriage returns end lines for ast as well, so tokens must be placed by ast's lines.
+    from core.milestones.propose import _bodies
+    source = ('"""Module prose."""\rimport os\rfrom .units import KG\r\rLIMITS = {"parcel": 30}\r\r'
+              '@register\rclass Meter:\r    """Class prose."""\r    UNIT = "kg"\r\r'
+              '    @property\r    def read(self):\r        return KG\r\r    class Inner:\r        SCALE = 1000\r\r'
+              'if os.name == "nt":\r    import ntpath\r    SEP = "/"\r\r'
+              'def helper():\r    class Local:\r        HIDDEN = 1\r    return Local\r')
+    assert dict(_bodies(source)) == {'<module>': {'LIMITS', '"parcel"', '30', 'os', '"nt"', 'SEP', '"/"'},
+                                     'class Meter': {'UNIT', '"kg"'}, 'class Inner': {'SCALE', '1000'}}
+
+
