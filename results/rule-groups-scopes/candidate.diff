+def _bodies(source):
+    """Each module's and class's own statements, beside its functions: a rule is often kept in a table
+    no function holds. Imports, docstrings and decorators are not rules."""
+    try:
+        tree = ast.parse(source)
+    except (SyntaxError, ValueError):
+        return []
+    owner, gone = {}, set()
+    for node in ast.walk(tree):
+        if isinstance(node, (ast.Module, ast.ClassDef)):
+            body = node.body
+            if body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant) \
+                    and isinstance(body[0].value.value, str):
+                gone.update(range(body[0].lineno, body[0].end_lineno + 1))
+        if isinstance(node, ast.ClassDef):
+            # Its name and bases are what its users share with it, not a rule it keeps.
+            start = node.body[0].lineno
+            gone.update(range(min([node.lineno] + [d.lineno for d in node.decorator_list]), start))
+            # ast.walk goes outward in, so a nested class takes its lines from the class around it.
+            owner.update((line, node) for line in range(start, node.end_lineno + 1))
+        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            gone.update(range(min([node.lineno] + [d.lineno for d in node.decorator_list]), node.end_lineno + 1))
+        elif isinstance(node, (ast.Import, ast.ImportFrom)):
+            gone.update(range(node.lineno, node.end_lineno + 1))
+    # Placed by ast's lines, which a lone \r also ends.
+    lines = ''.join(line.rstrip('\r\n') + '\n' for line in re.findall(r'[^\r\n]*(?:\r\n|\r|\n)|[^\r\n]+\Z', source))
+    words = defaultdict(set)
+    try:
+        for token in tokenize.generate_tokens(io.StringIO(lines).readline):
+            line = token.start[0]
+            if token.type in (tokenize.NAME, tokenize.STRING, tokenize.NUMBER) and token.string not in COMMON \
+                    and line not in gone:
+                words[owner.get(line, tree)].add(token.string)
+    except (tokenize.TokenError, IndentationError, SyntaxError):
+        pass
+    return [('<module>' if scope is tree else f'class {scope.name}', found) for scope, found in words.items()]
+
