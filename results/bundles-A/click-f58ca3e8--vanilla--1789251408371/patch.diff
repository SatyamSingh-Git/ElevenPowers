@@ -1,3 +1,9 @@
+## Unreleased
+
+- `Sentinel` members (`UNSET`, `FLAG_NEEDS_VALUE`) can be pickled again. The
+  inherited `Enum.__reduce_ex__` reconstructed members by looking up their
+  `object()` value, which isn't preserved across a pickle round-trip.
+
 ## Version 8.5.0
 
 Released 2026-08-24
diff --git a/src/click/_utils.py b/src/click/_utils.py
index 05ee2e9..deb2e53 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,12 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, protocol: int) -> tuple[t.Any, ...]:
+        # The default Enum.__reduce_ex__ reconstructs members by looking up
+        # their `object()` value, which isn't preserved across a pickle
+        # round-trip. Look up by name instead.
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
