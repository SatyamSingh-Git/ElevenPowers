index c593a13..78901eb 100644
--- a/src/markupsafe/__init__.py
+++ b/src/markupsafe/__init__.py
@@ -208,6 +208,12 @@ class Markup(str):
         formatter = EscapeFormatter(self.escape)
         return self.__class__(formatter.vformat(self, args, kwargs))
 
+    def format_map(  # type: ignore[override]
+        self, map: t.Mapping[str, t.Any]
+    ) -> "Markup":
+        formatter = EscapeFormatter(self.escape)
+        return self.__class__(formatter.vformat(self, (), map))
+
     def __html_format__(self, format_spec: str) -> "Markup":
         if format_spec:
             raise ValueError("Unsupported format specification for Markup.")
diff --git a/tests/test_markupsafe.py b/tests/test_markupsafe.py
index a62ebf9..d205c6b 100644
--- a/tests/test_markupsafe.py
+++ b/tests/test_markupsafe.py
@@ -108,6 +108,17 @@ def test_format():
     assert result == "<bar/>"
 
 
+def test_format_map():
+    result = Markup("<em>{awesome}</em>").format_map({"awesome": "<awesome>"})
+    assert result == "<em>&lt;awesome&gt;</em>"
+
+    result = Markup("{value[bar]}").format_map({"value": {"bar": "<bar/>"}})
+    assert result == "&lt;bar/&gt;"
+
+    result = Markup("{value[bar]}").format_map({"value": {"bar": Markup("<bar/>")}})
+    assert result == "<bar/>"
+
+
 def test_formatting_empty():
     formatted = Markup("{}").format(0)
     assert formatted == Markup("0")
