+    def _write_ns_ref_checks(self, target: nodes.Expr, frame: Frame) -> None:
+        # Namespace assignment targets require a runtime check that the
+        # referenced object is actually a namespace. These are written
+        # ahead of the assignment itself (deduplicated by name) so that a
+        # target that is a tuple of multiple namespace refs doesn't end up
+        # with the check emitted in the middle of the tuple literal.
+        if isinstance(target, nodes.NSRef):
+            ref_nodes: t.Iterable[nodes.NSRef] = (target,)
+        else:
+            ref_nodes = target.find_all(nodes.NSRef)
+
+        seen: t.Set[str] = set()
+        for ref_node in ref_nodes:
+            if ref_node.name in seen:
+                continue
+            seen.add(ref_node.name)
+            ref = frame.symbols.ref(ref_node.name)
+            self.writeline(f"if not isinstance({ref}, Namespace):")
+            self.indent()
+            self.writeline(
+                "raise TemplateRuntimeError"
+                '("cannot assign attribute on non-namespace object")'
+            )
+            self.outdent()
+
