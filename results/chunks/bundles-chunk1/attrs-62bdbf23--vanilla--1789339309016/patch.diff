+@pytest.mark.skipif(not PY_3_13_PLUS, reason="copy.replace() is 3.13+")
+class TestReplace:
+    """
+    Tests for __replace__ and copy.replace() integration.
+    """
+
+    def test_replace(self):
+        """
+        copy.replace() creates a new instance with changes applied.
+        """
+
+        @attr.s
+        class C:
+            a = attr.ib()
+            b = attr.ib()
+
+        i1 = C(1, 2)
+        i2 = copy.replace(i1, a=3)
+
+        assert i1 is not i2
+        assert C(3, 2) == i2
+
+    def test_no_changes(self):
+        """
+        copy.replace() without changes returns an equal but distinct copy.
+        """
+
+        @attr.s
+        class C:
+            a = attr.ib()
+
+        i1 = C(1)
+        i2 = copy.replace(i1)
+
+        assert i1 is not i2
+        assert i1 == i2
+
+    def test_explicit_replace(self):
+        """
+        A custom __replace__ is not overwritten.
+        """
+
+        @attr.s
+        class C:
+            a = attr.ib()
+
+            def __replace__(self, **changes):
+                return "not replaced"
+
+        assert "not replaced" == copy.replace(C(1), a=2)
