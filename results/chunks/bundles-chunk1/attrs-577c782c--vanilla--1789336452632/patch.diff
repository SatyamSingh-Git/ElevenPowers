diff --git a/src/attr/_version_info.py b/src/attr/_version_info.py
index 51a1312..27f1888 100644
--- a/src/attr/_version_info.py
+++ b/src/attr/_version_info.py
@@ -84,3 +84,6 @@ class VersionInfo:
