+@pytest.mark.skipif(not PY_3_13_PLUS, reason="copy.replace is 3.13+")
+class TestReplace:
+    """
+    Tests for __replace__ and interaction with copy.replace().
+    """
+
+    def test_replace(self):
+        """
+        copy.replace() creates a new instance with changes applied.
+        """
+
+        @attr.define
+        class C:
+            a = attr.field()
+            b = attr.field()
+
+        i1 = C(1, 2)
+        i2 = copy.replace(i1, b=3)
+
+        assert i1 is not i2
+        assert i2 == C(1, 3)
+
+    def test_replace_frozen(self):
+        """
+        copy.replace() works on frozen classes.
+        """
+
+        @attr.frozen
+        class C:
+            a = attr.field()
+
+        i1 = C(1)
+        i2 = copy.replace(i1, a=2)
+
+        assert i2 == C(2)
+
+    def test_explicit_replace(self):
+        """
+        A custom __replace__ is not overwritten.
+        """
+
+        @attr.define
+        class C:
+            a = attr.field()
+
+            def __replace__(self, **changes):
+                return "custom"
+
+        assert copy.replace(C(1), a=2) == "custom"
+
         C1 = make_class("C1", {"a": attr.ib(kw_only=True), "b": attr.ib()})
         assert ("b",) == C1.__match_args__
