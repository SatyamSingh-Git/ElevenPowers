+    sha512_value = factory(signer_kwargs={"digest_method": hashlib.sha512}).dumps([42])
+    assert default_value == sha1_value
+    assert sha1_value == "[42].-9cNi0CxsSB3hZPNCe9a2eEs1ZM"
+    assert sha512_value == (
