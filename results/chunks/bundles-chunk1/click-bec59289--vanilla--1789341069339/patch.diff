diff --git a/tests/test_command_decorators.py b/tests/test_command_decorators.py
index 5bd268c..52303f9 100644
--- a/tests/test_command_decorators.py
+++ b/tests/test_command_decorators.py
@@ -1,3 +1,5 @@
+import importlib.metadata
+
 import pytest
 
 import click
@@ -90,3 +92,51 @@ def test_generate_name(name: str) -> None:
     f.__name__ = name
     f = click.command(f)
     assert f.name == "init-data"
+
+
+def test_version_option_maps_module_to_distribution_name(runner, monkeypatch):
+    module_name = __name__
+    monkeypatch.setattr(
+        importlib.metadata,
+        "packages_distributions",
+        lambda: {module_name: ["Test-Dist"]},
+    )
+    seen = []
+    monkeypatch.setattr(
+        importlib.metadata,
+        "version",
+        lambda name: seen.append(name) or "1.2.3",
+    )
+
+    @click.command()
+    @click.version_option()
+    def cli():
+        pass
+
+    result = runner.invoke(cli, ["--version"])
+    assert result.exit_code == 0, result.output
+    assert seen == ["Test-Dist"]
+    assert "1.2.3" in result.output
+
+
+def test_version_option_falls_back_on_ambiguous_module(runner, monkeypatch):
+    module_name = __name__
+    monkeypatch.setattr(
+        importlib.metadata,
+        "packages_distributions",
+        lambda: {module_name: ["Dist-A", "Dist-B"]},
+    )
+    monkeypatch.setattr(
+        importlib.metadata,
+        "version",
+        lambda name: "4.5.6" if name == module_name else 1 / 0,
+    )
+
+    @click.command()
+    @click.version_option()
+    def cli():
+        pass
+
+    result = runner.invoke(cli, ["--version"])
+    assert result.exit_code == 0
+    assert "4.5.6" in result.output
