+    @pytest.mark.parametrize(
+        ("takes_self", "takes_field"), itertools.product([True, False], repeat=2)
+    )
+    def test_adapter_gets_the_correct_args(self, takes_self, takes_field):
+        """
+        Depending on the flags, the adapter passes the correct arguments to
+        the wrapped converter.
+        """
+        received = None
+
+        def sink(*args):
+            nonlocal received
+            received = args
+            return args[0]
+
+        c = attr.Converter(
+            sink, takes_self=takes_self, takes_field=takes_field
+        )
+        instance, field = object(), object()
+
+        c(1, instance, field)
+
+        expected = (1,)
+        if takes_self:
+            expected += (instance,)
+        if takes_field:
+            expected += (field,)
+
+        assert expected == received
+
 
