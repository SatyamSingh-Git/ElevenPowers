diff --git a/src/click/_termui_impl.py b/src/click/_termui_impl.py
index 3336c37..de5d193 100644
--- a/src/click/_termui_impl.py
+++ b/src/click/_termui_impl.py
@@ -390,6 +390,15 @@ class MaybeStripAnsi(io.TextIOWrapper):
         super().__init__(stream, **kwargs)
         self.color = color
 
+    def __del__(self) -> None:
+        # The wrapped stream may be borrowed (e.g. stdout), so don't let the
+        # GC close it. Detach instead, as io.TextIOWrapper.__del__ would
+        # otherwise close the underlying stream.
+        try:
+            self.detach()
+        except Exception:
+            pass
+
     def write(self, text: str) -> int:
         if not self.color:
             text = strip_ansi(text)
