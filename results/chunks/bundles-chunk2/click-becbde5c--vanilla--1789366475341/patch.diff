             text = strip_ansi(text)
         return super().write(text)
 
+    def __del__(self) -> None:
+        # Closing a TextIOWrapper closes the underlying buffer too, which
+        # would close stdin/stdout or the pager's pipe out from under the
+        # rest of the process. Detach instead so garbage collection doesn't
+        # close those streams.
+        try:
+            self.detach()
+        except Exception:
+            pass
