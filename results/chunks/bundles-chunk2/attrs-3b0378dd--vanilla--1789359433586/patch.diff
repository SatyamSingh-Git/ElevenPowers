+    def test_field_transformer_generator(self):
+        """
+        field_transformer can return a generator of attributes.
+
+        Regression test for #1417.
+        """
+
+        def hook(cls, attribs):
+            yield from attribs
+
+        @attr.s(auto_attribs=True, field_transformer=hook)
+        class C:
+            x: int
+
+        assert {"x": 1} == attr.asdict(C(1))
+
 
