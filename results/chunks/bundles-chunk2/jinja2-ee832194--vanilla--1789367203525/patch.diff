+    def _output_namespace_checks(self, target: nodes.Expr, frame: Frame) -> None:
+        """Emit runtime checks that every namespace referenced by an
+        assignment target is actually a namespace object.  This has to
+        happen before the target is generated: since a target can be a
+        tuple containing namespace references, emitting the check while
+        generating the target would place it in the middle of the tuple
+        expression.
+        """
+        if isinstance(target, nodes.NSRef):
+            refs: t.Iterable[nodes.NSRef] = (target,)
+        else:
+            refs = target.find_all(nodes.NSRef)
+
+        seen: t.Set[str] = set()
+
+        for nsref in refs:
+            if nsref.name in seen:
+                continue
+
+            seen.add(nsref.name)
+            ref = frame.symbols.ref(nsref.name)
+            self.writeline(f"if not isinstance({ref}, Namespace):")
+            self.indent()
+            self.writeline(
+                "raise TemplateRuntimeError"
+                '("cannot assign attribute on non-namespace object")'
+            )
+            self.outdent()
+
