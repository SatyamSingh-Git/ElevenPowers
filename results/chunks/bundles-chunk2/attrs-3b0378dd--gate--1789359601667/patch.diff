+    def test_field_transformer_returns_generator(self):
+        """
+        A field_transformer that returns a generator (instead of a list or
+        tuple) is supported.
+
+        Regression test for #1417.
+        """
+
+        def hook(cls, attribs):
+            for a in attribs:
+                yield a
+
+        @attr.s(auto_attribs=True, field_transformer=hook)
+        class C:
+            x: int
+            y: int
+
+        assert ["x", "y"] == [a.name for a in attr.fields(C)]
+        assert {"x": 1, "y": 2} == attr.asdict(C(1, 2))
