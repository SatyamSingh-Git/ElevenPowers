             text = strip_ansi(text)
         return super().write(text)
 
+    def __del__(self) -> None:
+        # This wraps a stream we don't own, such as stdout or a pager
+        # process's stdin, which the caller is responsible for closing.
+        # Detach instead of letting TextIOWrapper's default __del__ close
+        # the underlying stream out from under them.
+        try:
+            self.detach()
+        except Exception:
+            pass
