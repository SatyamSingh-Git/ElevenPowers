 },
 "analysis": {
  "unit": "case; per-case mean over replicates of (superpowers - superpowers+ElevenPowers)",
  "co_primary": [
   "earlier groups lost (passed at the previous graded stage, not passed now), summed over stages",
   "stale documented facts at the end of each stage, summed over stages"
  ],
  "test": "two-sided exact Wilcoxon signed-rank over cases (eval.multistage_power.exact_signed_rank); zero differences dropped and counted; Holm across the two co-primaries",
  "comparable": "a conversation counts only if every stage was attempted and graded; others stay in the scheduled denominator, reported missing, never zero",
  "layout": "chosen after the pilot from results/multistage/power.json: the largest affordable layout with power >= 0.8 at ratio 0.5 at the pilot arm-A rate, else the cheapest, run as descriptive",
  "pilot_runs": "excluded from the analysis; no case is dropped or replaced on its pilot result"
 }
