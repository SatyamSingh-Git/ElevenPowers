diff --git a/changelog.d/1380.change.md b/changelog.d/1380.change.md
new file mode 100644
index 0000000..9612447
--- /dev/null
+++ b/changelog.d/1380.change.md
@@ -0,0 +1,2 @@
+`attrs.converters.pipe()` now only returns an instance of `attrs.Converter` if one of its arguments is a `attrs.Converter`.
+Otherwise, it returns a plain callable, like before.
diff --git a/src/attr/_make.py b/src/attr/_make.py
index 239ea2c..37bbbc3 100644
--- a/src/attr/_make.py
+++ b/src/attr/_make.py
@@ -2926,17 +2926,34 @@ def pipe(*converters):
     Type annotations will be inferred from the wrapped converters', if they
     have any.
 
+    An instance of `Converter` is only returned if any of the wrapped
+    converters are instances of `Converter`.
+
         converters (~collections.abc.Iterable[typing.Callable]):
             Arbitrary number of converters.
 
     .. versionadded:: 20.1.0
     """
+    return_instance = any(isinstance(c, Converter) for c in converters)
+
+    if return_instance:
+
+        def pipe_converter(val, inst, field):
+            for c in converters:
+                if isinstance(c, Converter):
+                    val = c(val, inst, field)
+                else:
+                    val = c(val)
+
+            return val
+
+    else:
 
-    def pipe_converter(val, inst, field):
-        for c in converters:
-            val = c(val, inst, field) if isinstance(c, Converter) else c(val)
+        def pipe_converter(val):
+            for c in converters:
+                val = c(val)
 
-        return val
+            return val
 
     if not converters:
         # If the converter list is empty, pipe_converter is the identity.
@@ -2957,4 +2974,6 @@ def pipe(*converters):
         if rt:
             pipe_converter.__annotations__["return"] = rt
 
-    return Converter(pipe_converter, takes_self=True, takes_field=True)
+    if return_instance:
+        return Converter(pipe_converter, takes_self=True, takes_field=True)
+    return pipe_converter
