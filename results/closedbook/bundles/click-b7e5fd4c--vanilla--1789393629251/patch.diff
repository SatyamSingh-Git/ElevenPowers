diff --git a/CHANGES.rst b/CHANGES.rst
index 8c058d5..86c5964 100644
--- a/CHANGES.rst
+++ b/CHANGES.rst
@@ -5,6 +5,11 @@ Version 8.4.2
 
 Unreleased
 
+-   Fix Fish shell completion, which was broken by an invalid escape sequence
+    in the completion script, and correctly escape newlines in completion
+    values so multi-line help strings don't corrupt the completion response.
+    :issue:`3043` :issue:`3502`
+
 
 Version 8.4.1
 -------------
diff --git a/src/click/shell_completion.py b/src/click/shell_completion.py
index b01e290..9961b57 100644
--- a/src/click/shell_completion.py
+++ b/src/click/shell_completion.py
@@ -181,7 +181,7 @@ function %(complete_func)s;
 COMP_CWORD=(commandline -t) %(prog_name)s);
 
     for completion in $response;
-        set -l metadata (string split \n $completion);
+        set -l metadata (string split \\n $completion);
 
         if test $metadata[1] = "dir";
             __fish_complete_directories $metadata[2];
@@ -426,16 +426,23 @@ class FishComplete(ShellComplete):
         .. versionchanged:: 8.4.0
             Escape newlines in value and help to fix completion errors with
             multi-line help strings.
+        .. versionchanged:: 8.4.2
+            Join the fields with the escaped newline as well, instead of a
+            real newline, so a single item survives fish's line-splitting
+            command substitution intact.
         """
-        # The fish completion script splits each response line on literal
-        # newlines, so any newline in the value or help would corrupt the
-        # frame. Replace them with the two-character escape "\n" so the text
-        # round-trips through fish without breaking the format. The "_"
-        # sentinel for missing help mirrors :class:`ZshComplete`.
+        # Fish's command substitution splits the whole response on real
+        # newlines, one entry per line, so each item's fields must stay on a
+        # single line to survive that split intact. Join them with the
+        # literal two-character escape "\n" instead, which the fish script
+        # un-escapes with ``string split``. This also covers newlines
+        # embedded in the value or help text itself, which would otherwise
+        # be mistaken for extra response lines. The "_" sentinel for missing
+        # help mirrors :class:`ZshComplete`.
         help_ = item.help or "_"
         value = item.value.replace("\n", r"\n")
         help_escaped = help_.replace("\n", r"\n")
-        return f"{item.type}\n{value}\n{help_escaped}"
+        return rf"{item.type}\n{value}\n{help_escaped}"
 
 
 ShellCompleteType = t.TypeVar("ShellCompleteType", bound="type[ShellComplete]")
