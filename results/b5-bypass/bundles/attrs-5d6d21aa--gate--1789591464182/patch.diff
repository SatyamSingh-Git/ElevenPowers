+    def test_pipe_of_adapters(self):
+        """
+        Converters that run in adapter mode -- which includes the ones
+        returned by pipe() -- don't hide the return type of the callable they
+        wrap.
+        """
+
+        def int2str(x: int, inst, field) -> str:
+            return str(x)
+
+        adapter = attr.Converter(int2str, takes_self=True, takes_field=True)
+        p = attr.converters.pipe(adapter)
+
+        assert p.converter.__annotations__["return"] is str
+
+        pp = attr.converters.pipe(p)
+
+        assert pp.converter.__annotations__["return"] is str
