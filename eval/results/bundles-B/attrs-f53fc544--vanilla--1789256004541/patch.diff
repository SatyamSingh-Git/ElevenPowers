+    def test_does_not_mutate_evolve(self):
+        """
+        Generating __replace__ does not mutate attr.evolve's own dunders,
+        and each class's __replace__ gets its own, correct dunders.
+        """
+        module = attr.evolve.__module__
+        qualname = attr.evolve.__qualname__
+        doc = attr.evolve.__doc__
+
+        @attr.s
+        class C:
+            x = attr.ib()
+
+        @attr.s
+        class D:
+            x = attr.ib()
+
+        assert C.__replace__.__qualname__.endswith("C.__replace__")
+        assert D.__replace__.__qualname__.endswith("D.__replace__")
+        assert C.__replace__ is not D.__replace__
+
+        assert module == attr.evolve.__module__
+        assert qualname == attr.evolve.__qualname__
+        assert doc == attr.evolve.__doc__
+
