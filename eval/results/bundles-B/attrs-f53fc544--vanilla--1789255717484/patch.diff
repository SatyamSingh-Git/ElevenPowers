+    @pytest.mark.parametrize("slots", [True, False])
+    def test_does_not_mutate_evolve(self, slots):
+        """
+        Adding __replace__ to a class does not mutate attrs.evolve's
+        __module__/__qualname__/__doc__, and __replace__ is bound to the
+        class it belongs to -- not to whichever class was built last.
+        """
+        qualname, module, doc = (
+            attr.evolve.__qualname__,
+            attr.evolve.__module__,
+            attr.evolve.__doc__,
+        )
+
+        @attr.s(slots=slots)
+        class First:
+            x = attr.ib()
+
+        @attr.s(slots=slots)
+        class Second:
+            y = attr.ib()
+
+        assert attr.evolve.__qualname__ == qualname
+        assert attr.evolve.__module__ == module
+        assert attr.evolve.__doc__ == doc
+
+        assert First.__replace__.__qualname__.endswith("First.__replace__")
+        assert Second.__replace__.__qualname__.endswith(
+            "Second.__replace__"
+        )
+
