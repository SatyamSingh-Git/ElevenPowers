diff --git a/CHANGES.md b/CHANGES.md
index 3c9a94e..6049ede 100644
--- a/CHANGES.md
+++ b/CHANGES.md
@@ -1,3 +1,10 @@
+## Unreleased
+
+- Fix pickling of `Sentinel` members such as `UNSET`, which previously
+  raised `ValueError` on unpickling because the sentinel's `object()`
+  value is not itself picklable. `copy()` and `deepcopy()` are covered
+  by regression tests as well.
+
 ## Version 8.5.0
 
 Released 2026-08-24
diff --git a/src/click/_utils.py b/src/click/_utils.py
index 05ee2e9..c2c4be5 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,9 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, protocol: object) -> tuple[t.Any, ...]:
+        return getattr, (self.__class__, self._name_)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
