--- a/src/clinicbook/services/validation.py
+++ b/src/clinicbook/services/validation.py
@@ -19,7 +19,8 @@ def check_name(name):
 
 
 def check_phone(phone):
-    phone = phone.strip()
-    if not PHONE.fullmatch(phone):
-        raise ValidationError("invalid phone number")
-    return phone
+    """The number with any spaces taken out, as patients often type it in groups."""
+    digits = phone.replace(" ", "")
+    if not PHONE.fullmatch(digits):
+        raise ValidationError(f"invalid phone number: {phone.strip()}")
+    return digits
