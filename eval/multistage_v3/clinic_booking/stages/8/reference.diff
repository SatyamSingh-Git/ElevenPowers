diff --git a/src/clinicbook/services/fees.py b/src/clinicbook/services/fees.py
index 9a093f3..9c6af1d 100644
--- a/src/clinicbook/services/fees.py
+++ b/src/clinicbook/services/fees.py
@@ -23,12 +23,19 @@ class Charge:
 
 
 def charges(bookings, settings):
-    """What patients owe: one charge per no-show, by day and booking reference."""
-    owed = [
-        Charge(booking.id, booking.patient, booking.phone, booking.day, NO_SHOW_REASON, settings.no_show_fee)
-        for booking in bookings
-        if booking.status == NO_SHOW
-    ]
+    """What patients owe: one charge per no-show, by day and booking reference.
+
+    With `first_no_show_free` on, each phone number's earliest no-show is let off.
+    """
+    missed = sorted((b for b in bookings if b.status == NO_SHOW), key=lambda b: (b.starts_at, b.id))
+    owed, seen = [], set()
+    for booking in missed:
+        first = booking.phone not in seen
+        seen.add(booking.phone)
+        if first and settings.first_no_show_free:
+            continue
+        owed.append(Charge(booking.id, booking.patient, booking.phone, booking.day, NO_SHOW_REASON,
+                           settings.no_show_fee))
     return sorted(owed, key=lambda charge: (charge.day, charge.booking))
 
 
