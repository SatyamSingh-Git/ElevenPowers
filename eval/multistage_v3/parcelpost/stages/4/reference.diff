diff --git a/src/parcelpost/core/ids.py b/src/parcelpost/core/ids.py
index b209277..a145790 100644
--- a/src/parcelpost/core/ids.py
+++ b/src/parcelpost/core/ids.py
@@ -1,9 +1,9 @@
-"""Tracking numbers: PP, an eight-digit serial, one check digit, GB."""
-from itertools import cycle
+"""Tracking numbers: PP, an eight-digit serial, one check digit, GB (the UPU S10 layout)."""
 
 PREFIX = "PP"
 COUNTRY = "GB"
 SERIAL_DIGITS = 8
+WEIGHTS = (8, 6, 4, 2, 3, 5, 9, 7)
 
 
 def new_tracking_number(sequence):
@@ -14,5 +14,6 @@ def new_tracking_number(sequence):
 
 
 def _check_digit(serial):
-    total = sum(int(digit) * weight for digit, weight in zip(serial, cycle((3, 1))))
-    return (10 - total % 10) % 10
+    total = sum(int(digit) * weight for digit, weight in zip(serial, WEIGHTS))
+    check = 11 - total % 11
+    return {10: 0, 11: 5}.get(check, check)
diff --git a/src/parcelpost/services/scans.py b/src/parcelpost/services/scans.py
index 2d94722..4d680b3 100644
--- a/src/parcelpost/services/scans.py
+++ b/src/parcelpost/services/scans.py
@@ -54,5 +54,6 @@ def _plausible_number(number):
     if not NUMBER.match(number):
         return False
     serial, check = number[2:10], int(number[10])
-    total = sum(int(digit) * (3 if position % 2 == 0 else 1) for position, digit in enumerate(serial))
-    return (10 - total % 10) % 10 == check
+    total = sum(int(digit) * weight for digit, weight in zip(serial, (8, 6, 4, 2, 3, 5, 9, 7)))
+    expected = 11 - total % 11
+    return {10: 0, 11: 5}.get(expected, expected) == check
