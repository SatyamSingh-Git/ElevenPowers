 """How numbers look in tables, exports and reports."""
+from decimal import ROUND_HALF_UP, Decimal
 
 MEAN_DECIMALS = 2
 
@@ -10,7 +11,13 @@ SCORE_STYLES = {
 
 
 def format_percent(value, decimals=1):
-    return f'{value:.{decimals}f}'
+    """Rounded half up, as spreadsheets do: 12.5 shows as 13 with no decimals.
+
+    Formatting the float directly would round half to even, so the shortest
+    decimal form of the value is rounded instead.
+    """
+    step = Decimal(1).scaleb(-decimals)
+    return str(Decimal(repr(value)).quantize(step, rounding=ROUND_HALF_UP))
 
 
 def format_number(value, decimals=1):
