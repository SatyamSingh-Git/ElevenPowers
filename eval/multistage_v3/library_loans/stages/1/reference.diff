+@pytest.mark.parametrize('returned, fine', [(date(2026, 3, 10), 0), (date(2026, 3, 11), 0), (date(2026, 3, 12), 300)])
+def test_grace_period(at, returned, fine):
+    library = at()
+    loan = checkout(library, 'M1001', '31000004')
+    assert fines.fine_for(library.settings, loan, 'DVD', 1999, returned) == fine
+
+
+def test_grace_period_can_be_turned_off(at, home):
+    (home / 'lending.ini').write_text('[lending]\nfine_grace_days = 0\n', encoding='utf-8')
+    library = at()
+    loan = checkout(library, 'M1001', '31000004')
+    assert fines.fine_for(library.settings, loan, 'DVD', 1999, date(2026, 3, 10)) == 100
+
+
