diff --git a/src/lending/services/holds.py b/src/lending/services/holds.py
index ae9a219..1e3c437 100644
--- a/src/lending/services/holds.py
+++ b/src/lending/services/holds.py
@@ -63,6 +63,22 @@ def collected(library, hold):
     library.save_holds()
 
 
+def cancel_hold(library, card, title_id):
+    """Drop a member's hold; a copy set aside for them goes to the next member waiting."""
+    member = library.member(card)
+    title_id = title_id.strip()
+    hold = next((hold for hold in library.holds_of(member.card) if hold.title_id == title_id), None)
+    if hold is None:
+        raise refuse('no_hold', card=member.card, title=title_id)
+    library.holds.remove(hold)
+    if hold.status == READY:
+        queue = waiting(library, hold.title_id)
+        if queue:
+            _put_aside(library, queue[0], hold.barcode)
+    library.save_holds()
+    return hold
+
+
 def expire_holds(library):
     """Drop ready holds nobody collected in time; their copies go to the next in line."""
     today = library.today()
