diff --git a/src/lending/services/fines.py b/src/lending/services/fines.py
index 8c656f5..fca1522 100644
--- a/src/lending/services/fines.py
+++ b/src/lending/services/fines.py
@@ -75,6 +75,9 @@ def pay(library, card, amount):
     member = library.member(card)
     if amount <= 0:
         raise refuse('bad_amount', text=format_money(amount))
+    owed = balance(library, member.card)
+    if amount > owed:
+        raise refuse('overpayment', amount=format_money(amount), balance=format_money(owed))
     library.record(Entry(library.today(), 'payment', None, member.card, None, amount))
     return balance(library, member.card)
 
