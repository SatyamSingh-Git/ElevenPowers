+def test_hold_limit(at, home):
+    (home / 'lending.ini').write_text('[lending]\nmax_holds = 2\n', encoding='utf-8')
+    library = at()
+    holds.place_hold(library, 'M1001', 'T0001')
+    holds.place_hold(library, 'M1001', 'T0002')
+    with pytest.raises(LendingError) as raised:
+        holds.place_hold(library, 'M1001', 'T0003')
+    assert raised.value.message == 'M1001 already has 2 holds; the limit is 2'
+    assert at().settings.max_holds == 2
+
+
 def test_cancelling_a_ready_hold_passes_the_copy_on(at):
     library = at()
     holds.place_hold(library, 'M1001', 'T0002')
