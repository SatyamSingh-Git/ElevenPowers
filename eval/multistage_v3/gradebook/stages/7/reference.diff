diff --git a/src/gradebook/grading/late.py b/src/gradebook/grading/late.py
index a0c3e5e..affe3a8 100644
--- a/src/gradebook/grading/late.py
+++ b/src/gradebook/grading/late.py
@@ -43,3 +43,10 @@ def per_day(points, max_points, days, settings):
         return points
     percent = min(exact(settings.per_day) * days, exact(settings.cap))
     return max(Fraction(0), points - max_points * percent / 100)
+
+
+@late_rule("flat")
+def flat(points, max_points, days, settings):
+    if days == 0:
+        return points
+    return max(Fraction(0), points - max_points * exact(settings.flat) / 100)
