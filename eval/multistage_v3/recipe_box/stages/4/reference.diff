@@ -11,8 +13,13 @@ MAX_MINUTES = 24 * 60
 
 
 def recipe_id(title):
-    """The id a recipe is known by in the library and on the command line."""
-    return "-".join(title.lower().split())
+    """The id a recipe is known by in the library and on the command line.
+
+    Only a-z, 0-9 and dashes: accents are dropped, and any other character
+    separates words.
+    """
+    plain = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode("ascii")
+    return "-".join(re.sub(r"[^a-z0-9]+", " ", plain.lower()).split())
 
 
