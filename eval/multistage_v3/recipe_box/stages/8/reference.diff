diff --git a/src/recipebox/core/quantity.py b/src/recipebox/core/quantity.py
index 15e6e48..6317485 100644
--- a/src/recipebox/core/quantity.py
+++ b/src/recipebox/core/quantity.py
@@ -105,6 +105,18 @@ def format_amount(amount):
     return f"{whole} {fraction}" if whole else fraction
 
 
+def amount_as_number(amount):
+    """An amount for JSON: an int when whole, otherwise a float."""
+    return amount.numerator if amount.denominator == 1 else float(amount)
+
+
+def amount_from_number(value):
+    """Read a JSON number back as an amount; floats are taken to the nearest fraction over at most 1000."""
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:
+        raise AmountError(f"cannot read amount {value}")
+    return Fraction(value).limit_denominator(1000)
+
+
 def _nearest(amount):
     whole = amount.numerator // amount.denominator
     rest = amount - whole
