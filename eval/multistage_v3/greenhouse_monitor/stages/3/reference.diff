diff --git a/CHANGELOG.md b/CHANGELOG.md
index 2abeb03..13461fa 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -2,6 +2,7 @@
 
 ## Unreleased
 
+- Fix `calibrate` accepting negative offsets beyond `max_offset`; the error now reads `offset out of range: {offset} (limit {limit})`.
 - Sensor ids are case-insensitive and written to the readings log in upper case.
 - The readings log keeps the uncalibrated value in a new `raw` column after `value`.
 
diff --git a/docs/reference.md b/docs/reference.md
index 92f56f1..08dcb98 100644
--- a/docs/reference.md
+++ b/docs/reference.md
@@ -64,7 +64,7 @@ a site changes.
 | `missing sensor` | `missing sensor` | an ingest row or `record` without a sensor id |
 | `out of range` | `out of range: {value} {unit}` | a calibrated value outside the catalog range |
 | `duplicate reading` | `duplicate reading for {sensor}` | an ingest row repeating a sensor and time from the same file |
-| `offset limit` | `offset too large: {offset}` | CLI: `calibrate` refusing an offset beyond `max_offset` |
+| `offset limit` | `offset out of range: {offset} (limit {limit})` | CLI: `calibrate` refusing an offset beyond `max_offset` in either direction |
 | `no offset` | `no offset for {sensor}` | CLI: `calibrate --clear` for a sensor without an offset |
 | `hand-held kind` | `{kind} cannot be entered by hand` | CLI: `record` with a kind the hand-held meters cannot read |
 | `unknown setting` | `unknown setting: {name}` | settings.json naming a setting that does not exist |
diff --git a/src/greenhouse/storage/calibration.py b/src/greenhouse/storage/calibration.py
index ac9ccaf..e9f1d2f 100644
--- a/src/greenhouse/storage/calibration.py
+++ b/src/greenhouse/storage/calibration.py
@@ -22,9 +22,9 @@ class CalibrationStore:
         return self._offsets.get(sensor, 0.0)
 
     def set_offset(self, sensor, offset, limit):
-        """Set a sensor's offset; ``limit`` is the largest offset a site accepts."""
-        if offset > limit:
-            raise ValidationError(f"offset too large: {offset}")
+        """Set a sensor's offset; ``limit`` bounds its size in either direction."""
+        if abs(offset) > limit:
+            raise ValidationError(f"offset out of range: {offset} (limit {limit})")
         self._offsets[sensor.upper()] = offset
 
     def clear(self, sensor):
