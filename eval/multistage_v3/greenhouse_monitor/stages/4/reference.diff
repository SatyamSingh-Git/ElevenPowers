diff --git a/src/greenhouse/services/alerts.py b/src/greenhouse/services/alerts.py
index 5e17a02..db03144 100644
--- a/src/greenhouse/services/alerts.py
+++ b/src/greenhouse/services/alerts.py
@@ -9,6 +9,8 @@ def evaluate(latest, thresholds, settings, now):
 
     A sensor that has not reported for more than ``stale_minutes`` raises
     ``stale`` and is not checked against its limits: its value is old news.
+    A reading past a limit by more than ``critical_margin`` raises
+    ``critical_high`` or ``critical_low`` instead of ``high`` or ``low``.
     """
     alerts = []
     stale_after = timedelta(minutes=settings.stale_minutes)
@@ -17,17 +19,20 @@ def evaluate(latest, thresholds, settings, now):
         if now - reading.at > stale_after:
             alerts.append(_alert(reading, now, "stale", settings.stale_minutes))
             continue
-        alert = _limit_alert(reading, thresholds.limits(reading.zone, reading.kind), now)
+        limits = thresholds.limits(reading.zone, reading.kind)
+        alert = _limit_alert(reading, limits, now, settings.critical_margin)
         if alert is not None:
             alerts.append(alert)
     return alerts
 
 
-def _limit_alert(reading, limits, now):
+def _limit_alert(reading, limits, now, margin):
     if limits.high is not None and reading.value > limits.high:
-        return _alert(reading, now, "high", limits.high)
+        code = "critical_high" if reading.value - limits.high > margin else "high"
+        return _alert(reading, now, code, limits.high)
     if limits.low is not None and reading.value < limits.low:
-        return _alert(reading, now, "low", limits.low)
+        code = "critical_low" if limits.low - reading.value > margin else "low"
+        return _alert(reading, now, code, limits.low)
     return None
 
 
