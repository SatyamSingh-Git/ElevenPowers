@@ -67,6 +67,23 @@ def test_limit_and_stale_alerts():
     ]
 
 
+def test_readings_far_past_a_limit_are_critical():
+    thresholds = Thresholds({"gh1": {"temperature": Limits(low=10.0, high=30.0)}})
+    latest = {
+        "GH1-T01": reading("GH1-T01", "temperature", 35.0),
+        "GH1-T02": reading("GH1-T02", "temperature", 35.5),
+        "GH1-T03": reading("GH1-T03", "temperature", 4.0),
+    }
+    alerts = evaluate(latest, thresholds, Settings(), NOON)
+    assert [(a.sensor, a.code) for a in alerts] == [
+        ("GH1-T01", "high"),
+        ("GH1-T02", "critical_high"),
+        ("GH1-T03", "critical_low"),
+    ]
+    wide = evaluate(latest, thresholds, Settings(critical_margin=10.0), NOON)
+    assert [a.code for a in wide] == ["high", "high", "low"]
+
+
 def test_alerts_already_logged_today_are_not_repeated():
     thresholds = Thresholds({"gh1": {"temperature": Limits(high=30.0)}})
     alerts = evaluate({"GH1-T01": reading("GH1-T01", "temperature", 31.0)}, thresholds, Settings(), NOON)
