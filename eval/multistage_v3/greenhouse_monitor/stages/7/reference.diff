diff --git a/src/greenhouse/storage/plans.py b/src/greenhouse/storage/plans.py
index 88468e6..7e14600 100644
--- a/src/greenhouse/storage/plans.py
+++ b/src/greenhouse/storage/plans.py
@@ -1,14 +1,26 @@
-"""The irrigation plan, ``irrigation.csv``: the latest suggestion for each zone."""
+"""The irrigation plans, ``irrigation.csv``: each day's suggestions, oldest day first.
+
+A file from before plans were dated holds only the last plan and is started
+afresh.
+"""
 import csv
 from pathlib import Path
 
-PLAN_COLUMNS = ["zone", "minutes", "reason"]
+PLAN_COLUMNS = ["date", "zone", "minutes", "reason"]
 
 
-def write_plan(path, suggestions):
-    """Replace the plan with these suggestions, in the order given."""
-    with Path(path).open("w", newline="", encoding="utf-8") as handle:
+def write_plan(path, suggestions, day):
+    """Store ``day``'s plan, replacing any plan already written for that day."""
+    path = Path(path)
+    kept = []
+    if path.exists():
+        with path.open(newline="", encoding="utf-8") as handle:
+            rows = list(csv.reader(handle))
+        if rows and rows[0] == PLAN_COLUMNS:
+            kept = [row for row in rows[1:] if row and row[0] != day.isoformat()]
+    with path.open("w", newline="", encoding="utf-8") as handle:
         writer = csv.writer(handle, lineterminator="\n")
         writer.writerow(PLAN_COLUMNS)
+        writer.writerows(kept)
         for suggestion in suggestions:
-            writer.writerow([suggestion.zone, suggestion.minutes, suggestion.reason])
+            writer.writerow([day.isoformat(), suggestion.zone, suggestion.minutes, suggestion.reason])
