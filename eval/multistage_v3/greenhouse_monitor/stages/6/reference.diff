diff --git a/src/greenhouse/services/irrigation.py b/src/greenhouse/services/irrigation.py
index 45e9e2c..f988fb5 100644
--- a/src/greenhouse/services/irrigation.py
+++ b/src/greenhouse/services/irrigation.py
@@ -2,7 +2,9 @@
 
 A zone is watered when its driest soil probe is more than ``dry_margin``
 points below the zone's target. Each missing point asks for
-``minutes_per_point`` minutes, up to ``max_irrigation_minutes``.
+``minutes_per_point`` minutes, up to ``max_irrigation_minutes``. The valve
+timers take whole multiples of ``timer_step_minutes``, so suggestions are
+rounded up to one.
 """
 from math import ceil
 
@@ -33,9 +35,16 @@ def _suggestion(zone, moisture, settings):
     deficit = target - moisture
     if deficit <= settings.dry_margin:
         return Suggestion(zone.id, 0, f"moisture {moisture:.1f}% near target {target:.1f}%")
-    minutes = min(ceil(deficit * settings.minutes_per_point), settings.max_irrigation_minutes)
+    minutes = _on_timer(ceil(deficit * settings.minutes_per_point), settings)
     return Suggestion(zone.id, minutes, f"moisture {moisture:.1f}% below target {target:.1f}%")
 
 
+def _on_timer(minutes, settings):
+    """Round up to whole timer steps, never past the longest run allowed."""
+    step = settings.timer_step_minutes
+    longest = settings.max_irrigation_minutes // step * step
+    return min(ceil(minutes / step) * step, longest)
+
+
 def total_minutes(suggestions):
     return sum(suggestion.minutes for suggestion in suggestions)
