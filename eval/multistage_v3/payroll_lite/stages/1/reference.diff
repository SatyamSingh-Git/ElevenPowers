diff --git a/tests/test_payrun_file.py b/tests/test_payrun_file.py
new file mode 100644
index 0000000..e12c913
--- /dev/null
+++ b/tests/test_payrun_file.py
@@ -0,0 +1,48 @@
+from datetime import date
+from decimal import Decimal
+import json
+
+from payroll.model.payslip import Line, PayRun, Payslip
+from payroll.model.period import PayPeriod
+from payroll.storage.payrun_file import read_payrun, write_payrun
+
+PERIOD = PayPeriod("2026-W01", date(2026, 1, 5), date(2026, 1, 11), date(2026, 1, 14))
+SLIP = Payslip(
+    "E001", "Ana Lima",
+    (Line("basic", "Ordinary hours", Decimal("975.00"), Decimal("39.00"), Decimal("25.00")),
+     Line("deduction", "Pension", Decimal("50.63"))),
+    Decimal("975.00"), Decimal("132.12"), Decimal("50.63"), Decimal("792.25"),
+)
+
+
+def test_money_is_written_as_whole_cents(tmp_path):
+    path = tmp_path / "run.json"
+    write_payrun(path, PayRun(PERIOD, (SLIP,)))
+    document = json.loads(path.read_text(encoding="utf-8"))
+    assert document["schema"] == 2
+    slip = document["payslips"][0]
+    assert (slip["gross"], slip["tax"], slip["deductions"], slip["net"]) == (97500, 13212, 5063, 79225)
+    assert slip["lines"][0] == {"kind": "basic", "label": "Ordinary hours", "hours": "39.00", "rate": 2500,
+                                "amount": 97500}
+    assert document["totals"]["net"] == 79225
+
+
+def test_written_run_reads_back(tmp_path):
+    path = tmp_path / "run.json"
+    write_payrun(path, PayRun(PERIOD, (SLIP,)))
+    assert read_payrun(path) == PayRun(PERIOD, (SLIP,))
+
+
+def test_schema_1_files_still_read(tmp_path):
+    path = tmp_path / "2026-W01.json"
+    path.write_text(json.dumps({
+        "schema": 1, "period": "2026-W01", "start": "2026-01-05", "end": "2026-01-11", "pay_date": "2026-01-14",
+        "payslips": [{"employee_id": "E001", "name": "Ana Lima", "gross": "975.00", "tax": "132.12",
+                      "deductions": "50.63", "net": "792.25",
+                      "lines": [{"kind": "basic", "label": "Ordinary hours", "hours": "39.00", "rate": "25.00",
+                                 "amount": "975.00"},
+                                {"kind": "deduction", "label": "Pension", "hours": None, "rate": None,
+                                 "amount": "50.63"}]}],
+        "totals": {"gross": "975.00", "tax": "132.12", "deductions": "50.63", "net": "792.25"},
+    }), encoding="utf-8")
+    assert read_payrun(path) == PayRun(PERIOD, (SLIP,))
