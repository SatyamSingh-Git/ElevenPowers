+def test_ordinary_hours_beyond_the_weekly_threshold_are_overtime(settings):
+    days = [entry("E001", f"2026-01-{day:02d}", "8") for day in range(5, 11)]
+    hours = split_hours(days, settings)
+    assert (hours.ordinary, hours.overtime) == (Decimal("40"), Decimal("8"))
+
+
+def test_daily_overtime_does_not_count_toward_the_week(settings):
+    days = [entry("E001", "2026-01-05", "10")] + [entry("E001", f"2026-01-{day:02d}", "8") for day in range(6, 10)]
+    hours = split_hours(days, settings)
+    assert (hours.ordinary, hours.overtime) == (Decimal("40"), Decimal("2"))
+
+
+def test_weeks_are_counted_monday_to_sunday(settings):
+    days = [entry("E001", f"2026-01-{day:02d}", "8") for day in range(7, 14)]
+    hours = split_hours(days, settings)
+    assert (hours.ordinary, hours.overtime) == (Decimal("56"), 0)
+
+
 def test_public_holiday_hours_are_never_ordinary_or_overtime(settings):
