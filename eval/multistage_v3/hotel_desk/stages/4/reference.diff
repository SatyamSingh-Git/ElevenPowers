@@ -12,7 +12,7 @@ class ChargeCode:
     tax_category: str
 
 
-ROOM = "RM"
+ROOM = "ROOM"
 TAX = "TAX"
 LATE_CHECKOUT = "LCO"
 
@@ -28,11 +28,14 @@ CHARGE_CODES = {
         ChargeCode(LATE_CHECKOUT, "Late check-out", "lodging"),
     )
 }
+# Codes retired from posting that the desk still accepts on the way in.
+ALIASES = {"RM": ROOM}
 
 
 def lookup(code):
+    wanted = code.upper()
     try:
-        return CHARGE_CODES[code.upper()]
+        return CHARGE_CODES[ALIASES.get(wanted, wanted)]
     except KeyError:
         raise ValidationError(f"Unknown charge code: {code}") from None
 
