+    def _save(self, holds):
+        cutoff = self.clock.now() - timedelta(minutes=self.settings.hold_keep_minutes)
+        for hold_id in [key for key, hold in holds.items() if hold.expires < cutoff]:
+            del holds[hold_id]
         self.store.save_holds(holds)
