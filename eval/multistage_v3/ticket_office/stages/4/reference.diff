diff --git a/src/boxoffice/model/concessions.py b/src/boxoffice/model/concessions.py
index 68e3a35..5bf5ea0 100644
--- a/src/boxoffice/model/concessions.py
+++ b/src/boxoffice/model/concessions.py
@@ -9,14 +9,21 @@ CONCESSIONS = {
     "student": 25,
 }
 
+# Concession prices are rounded to a multiple of this, so the counter rarely handles coppers.
+ROUNDING = 50
+
 
 def concession_price(face, name):
     """The price of a seat with face value `face` sold at concession `name`, in pence.
 
-    The discount is rounded to the nearest penny, halves up.
+    The discount is rounded to the nearest penny, halves up. A price below
+    the face value is then rounded to the nearest ROUNDING pence, halves up.
     """
     try:
         percent = CONCESSIONS[name]
     except KeyError:
         raise BoxOfficeError("unknown-concession", name=name) from None
-    return face - (face * percent + 50) // 100
+    if not percent:
+        return face
+    price = face - (face * percent + 50) // 100
+    return (price + ROUNDING // 2) // ROUNDING * ROUNDING
