+def test_free_wheelchair_spaces_have_their_own_state(office):
+    states = office.seat_states("TEMP-0520")
+    assert (states["B5"], states["B6"]) == ("free", "wheelchair")
+    hold = office.holds.place("TEMP-0520", ["B6"])
+    assert office.seat_states("TEMP-0520")["B6"] == "held"
+    office.holds.release(hold.id)
+    assert office.seat_states("TEMP-0520")["B6"] == "wheelchair"
+
+
+def test_best_available_leaves_wheelchair_spaces(office):
+    office.sales.checkout(office.holds.place("TEMP-0520", [f"A{n}" for n in range(1, 7)]).id)
+    with pytest.raises(BoxOfficeError):
+        office.holds.place_best("TEMP-0520", 6, section="Stalls")
+    assert office.holds.place_best("TEMP-0520", 5, section="Stalls").seats == ["B1", "B2", "B3", "B4", "B5"]
+
+
