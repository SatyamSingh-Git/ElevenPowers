diff --git a/src/budgetbook/rules/matchers.py b/src/budgetbook/rules/matchers.py
index ca84d53..7cb0205 100644
--- a/src/budgetbook/rules/matchers.py
+++ b/src/budgetbook/rules/matchers.py
@@ -5,6 +5,12 @@ from ..errors import ValidationError
 
 
 def _contains(pattern, payee):
+    # Whole words only, so a rule for BP does not also catch EBPAY.
+    words = re.escape(pattern.strip())
+    return re.search(rf"(?<!\w){words}(?!\w)", payee, re.IGNORECASE) is not None
+
+
+def _anywhere(pattern, payee):
     return pattern.casefold() in payee.casefold()
 
 
@@ -25,6 +31,7 @@ MATCHERS = {
     "prefix": _prefix,
     "exact": _exact,
     "regex": _regex,
+    "anywhere": _anywhere,
 }
 
 
