+def render_markdown(columns, rows):
+    def line(values):
+        return "| " + " | ".join(values) + " |"
+
+    out = [line(column.name for column in columns), line("---" for _ in columns)]
+    out += [line(_text(value).replace("|", "\\|") for value in row) for row in rows]
+    return "\n".join(out) + "\n"
+
+
 RENDERERS = {
     "table": render_table,
     "csv": render_csv,
     "json": render_json,
+    "markdown": render_markdown,
 }
 
 
