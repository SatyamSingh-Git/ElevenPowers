--- a/src/tinyroute/patterns.py
+++ b/src/tinyroute/patterns.py
@@ -52,6 +52,26 @@ class Pattern:
     def names(self):
         return [part.name for part in self.parameters]
 
+    @property
+    def specificity(self):
+        """A sort key, lower for more specific patterns.
+
+        One rank per path segment from the left: 0 for fixed text, 1 for a
+        segment holding a parameter, 2 for one holding a parameter that can
+        span slashes.
+        """
+        by_name = {part.name: part for part in self.parameters}
+        ranks = []
+        for segment in self.text.split('/')[1:]:
+            names = [found['name'] for found in PARAMETER.finditer(segment)]
+            if not names:
+                ranks.append(0)
+            elif any(by_name[name].converter.spans_slashes for name in names):
+                ranks.append(2)
+            else:
+                ranks.append(1)
+        return tuple(ranks)
+
     def match(self, path):
         """The converted parameters if ``path`` matches, otherwise None."""
         found = self.regex.fullmatch(path)
