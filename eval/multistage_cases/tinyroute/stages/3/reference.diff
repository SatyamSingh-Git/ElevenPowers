@@ -1,3 +1,5 @@
+import uuid
+
 import pytest
 
 from tinyroute import BuildError, RouteError, register_converter
@@ -29,6 +31,18 @@ def test_slug_and_path_parameters():
     assert Pattern('/files/<path:name>').match('/files/a/b.txt') == {'name': 'a/b.txt'}
 
 
+def test_uuid_parameter():
+    pattern = Pattern('/things/<uuid:id>')
+    text = '12345678-90ab-cdef-1234-567890abcdef'
+    assert pattern.match('/things/' + text) == {'id': uuid.UUID(text)}
+    assert pattern.match('/things/' + text.upper()) is None
+    assert pattern.match('/things/' + text.replace('-', '')) is None
+    assert pattern.build({'id': uuid.UUID(text)}, 't') == '/things/' + text
+    assert pattern.build({'id': '{' + text.upper() + '}'}, 't') == '/things/' + text
+    with pytest.raises(BuildError):
+        pattern.build({'id': 'not-a-uuid'}, 't')
+
+
 def test_parameters_are_percent_decoded():
     assert Pattern('/files/<name>').match('/files/a%20b') == {'name': 'a b'}
 
