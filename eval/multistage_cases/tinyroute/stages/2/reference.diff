+
+
+def test_each_cookie_gets_its_own_header():
+    response = Response()
+    response.set_cookie('session', 'abc')
+    response.delete_cookie('old')
+    assert response.header_values('set-cookie') == [
+        'session=abc; Path=/; HttpOnly', 'old=; Path=/; Max-Age=0; HttpOnly']
+
+
+def test_headers_are_ordered_pairs():
+    response = Response(headers=[('Link', '<a>'), ('Link', '<b>')])
+    response.add_header('X-One', '1')
+    assert response.headers == [
+        ('Content-Type', 'text/plain; charset=utf-8'), ('Link', '<a>'), ('Link', '<b>'), ('X-One', '1')]
+    response.set_header('link', '<c>')
+    assert response.header_values('Link') == ['<c>']
+    assert response.header('LINK') == '<c>'
+
+
+def test_content_type_in_headers_replaces_the_default():
+    response = Response(headers={'content-type': 'text/html'})
+    assert response.header_values('Content-Type') == ['text/html']
 
 
