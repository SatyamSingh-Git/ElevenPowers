-    def url_for(self, name, **values):
-        """The path of route ``name``; values that are not parameters go in the query string."""
+    def url_for(self, name, _query=None, **values):
+        """The path of route ``name`` filled in with ``values``, then ``_query`` as a query string.
+
+        Every keyword in ``values`` must be a path parameter of the route. A
+        list in ``_query`` repeats its name once per item.
+        """
         route = self.named.get(name)
         if route is None:
             raise BuildError(f"no route named '{name}'")
+        for key in values:
+            if key not in route.pattern.names:
+                raise BuildError(f"unknown parameter '{key}' for route '{name}'")
         path = route.pattern.build(values, name)
-        extra = {key: value for key, value in values.items() if key not in route.pattern.names}
-        if extra:
-            path += '?' + urlencode(extra, doseq=True)
+        if _query:
+            path += '?' + urlencode(_query, doseq=True)
         return path
