diff --git a/src/tinyroute/errors.py b/src/tinyroute/errors.py
index a24139e..fdb1123 100644
--- a/src/tinyroute/errors.py
+++ b/src/tinyroute/errors.py
@@ -13,15 +13,19 @@ class BuildError(RouteError):
 class HTTPError(Exception):
     """An error the application answers with a status code instead of crashing.
 
-    Subclasses set ``status``; the message defaults to the status reason in
-    lower case, so ``status = 410`` reads ``gone``.
+    Subclasses set ``status`` and usually ``code``, the stable name clients
+    can rely on. The code defaults to ``http_<status>`` and the message to the
+    status reason in lower case, so ``status = 410`` gives ``http_410`` and ``gone``.
     """
 
     status = 500
+    code = None
 
     def __init__(self, message=None, headers=None):
         if message is None:
             message = STATUS_REASONS.get(self.status, 'error').lower()
+        if self.code is None:
+            self.code = f'http_{self.status}'
         self.message = message
         self.headers = dict(headers or {})
         super().__init__(message)
@@ -29,10 +33,12 @@ class HTTPError(Exception):
 
 class BadRequest(HTTPError):
     status = 400
+    code = 'bad_request'
 
 
 class NotFound(HTTPError):
     status = 404
+    code = 'not_found'
 
     def __init__(self, path):
         self.path = path
@@ -41,6 +47,7 @@ class NotFound(HTTPError):
 
 class MethodNotAllowed(HTTPError):
     status = 405
+    code = 'method_not_allowed'
 
     def __init__(self, method, path, allowed):
         self.allowed = sorted(allowed)
@@ -50,3 +57,4 @@ class MethodNotAllowed(HTTPError):
 
 class InternalError(HTTPError):
     status = 500
+    code = 'internal_error'
