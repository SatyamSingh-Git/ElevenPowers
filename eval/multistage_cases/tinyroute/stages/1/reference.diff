+    client = Client(make_app())
+    assert client.get('/nope').json()['error']['code'] == 'not_found'
+    assert client.delete('/users/1').json()['error']['code'] == 'method_not_allowed'
+
+
+def test_subclass_sets_its_own_code():
+    app = App()
+
+    class Teapot(HTTPError):
+        status = 418
+        code = 'teapot'
+
+    @app.route('/tea')
+    def tea(request):
+        raise Teapot('short and stout')
+
+    assert Client(app).get('/tea').json() == {
+        'error': {'code': 'teapot', 'message': 'short and stout'}, 'status': 418}
 
 
