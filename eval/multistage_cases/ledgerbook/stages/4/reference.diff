+
+def test_zero_posting_in_a_journal(tmp_path):
+    zero = {"type": "txn", "date": "2026-01-01", "description": "Oops",
+            "postings": [{"account": "Assets:Cash", "amount": "0.00"}, {"account": "Assets:Cash", "amount": "0.00"}]}
