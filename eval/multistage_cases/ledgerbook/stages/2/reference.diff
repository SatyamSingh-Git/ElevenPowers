+    if start is not None:
+        running = sum(amount for txn, amount in postings if txn.date < start)
+        lines.append(StatementLine(start, OPENING_LABEL, None, running))
+    for txn, amount in postings:
+        if (start is None or txn.date >= start) and (end is None or txn.date <= end):
+            running += amount
+            lines.append(StatementLine(txn.date, txn.description, amount, running))
     return lines
 
 
