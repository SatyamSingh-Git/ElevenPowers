diff --git a/tests/test_cli.py b/tests/test_cli.py
index 3a5c8f4..14ec693 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -42,3 +42,15 @@ def test_statement_and_summary(books, capsys):
     assert "Start" in capsys.readouterr().out
     assert main([books, "summary"]) == 0
     assert "Equity" in capsys.readouterr().out
+
+
+def test_statement_range(books, capsys):
+    assert main([books, "post", "2026-01-05", "Lunch", "Expenses:Food=12.50", "Assets:Cash"]) == 0
+    assert main([books, "post", "2026-01-09", "Dinner", "Expenses:Food=20", "Assets:Cash"]) == 0
+    capsys.readouterr()
+    assert main([books, "statement", "Assets:Cash", "--from", "2026-01-02", "--to", "2026-01-06"]) == 0
+    out = capsys.readouterr().out
+    assert "Opening balance" in out and "Lunch" in out
+    assert "Start" not in out and "Dinner" not in out
+    assert main([books, "statement", "Assets:Cash", "--from", "January"]) == 1
+    assert "invalid date: January" in capsys.readouterr().err
diff --git a/tests/test_reports.py b/tests/test_reports.py
index 2c6b88d..ea1b242 100644
--- a/tests/test_reports.py
+++ b/tests/test_reports.py
@@ -33,3 +33,23 @@ def test_summary(household):
         "assets": 420000, "liabilities": 4250, "equity": 250000,
         "income": 320000, "expenses": 154250, "net_income": 165750,
     }
+
+
+def test_statement_range_opens_with_the_carried_balance(household):
+    lines = statement(household, "Assets:Bank", start="2026-01-15", end="2026-01-31")
+    assert [(str(l.date), l.description, l.amount, l.balance) for l in lines] == [
+        ("2026-01-15", "Opening balance", None, 250000),
+        ("2026-01-15", "Salary", 320000, 570000),
+        ("2026-01-31", "Rent", -150000, 420000),
+    ]
+
+
+def test_statement_end_only_has_no_opening_line(household):
+    lines = statement(household, "Assets:Bank", end="2026-01-15")
+    assert [(l.amount, l.balance) for l in lines] == [(250000, 250000), (320000, 570000)]
+
+
+def test_render_statement_range(household):
+    text = render_statement(household, "Assets:Bank", start="2026-02-01")
+    assert text.splitlines()[3].split() == ["2026-02-01", "Opening", "balance", "4200.00"]
+    assert text.splitlines()[-1].split() == ["2026-02-02", "Cash", "withdrawal", "-200.00", "4000.00"]
