+def _amount(value, version, currency):
+    # A version 1 journal that has been appended to since holds decimal text as well.
+    if version == 1 and type(value) is int:
+        return value
+    if not isinstance(value, str):
+        raise LedgerError(f"amount must be decimal text: {value!r}")
+    return parse_amount(value, currency)
+
+
+def _apply(ledger, record, version):
     kind = _field(record, "type")
     if kind == "open":
         ledger.open(_field(record, "account"))
     elif kind == "txn":
-        postings = [(_field(p, "account"), _field(p, "amount")) for p in _field(record, "postings")]
+        postings = [(_field(p, "account"), _amount(_field(p, "amount"), version, ledger.currency))
+                    for p in _field(record, "postings")]
         ledger.post(make_transaction(_field(record, "date"), _field(record, "description"), postings))
     else:
         raise LedgerError(f"unknown record type: {kind}")
