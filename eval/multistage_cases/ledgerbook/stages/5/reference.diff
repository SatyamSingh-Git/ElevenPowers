diff --git a/src/ledgerbook/money.py b/src/ledgerbook/money.py
index de21d1e..944f87b 100644
--- a/src/ledgerbook/money.py
+++ b/src/ledgerbook/money.py
@@ -30,11 +30,16 @@ def parse_amount(text, currency=DEFAULT_CURRENCY):
     return -minor if sign else minor
 
 
-def format_amount(minor, currency=DEFAULT_CURRENCY):
-    """Write integer minor units as decimal text: 1250 -> "12.50" in USD."""
+def format_amount(minor, currency=DEFAULT_CURRENCY, grouping=True):
+    """Write integer minor units as decimal text: 123456 -> "1,234.56" in USD.
+
+    With grouping=False there are no thousands separators, which is the form
+    parse_amount reads back.
+    """
     digits = currency_digits(currency)
     sign = "-" if minor < 0 else ""
     whole, fraction = divmod(abs(minor), 10**digits)
+    whole = f"{whole:,}" if grouping else str(whole)
     if not digits:
         return f"{sign}{whole}"
     return f"{sign}{whole}.{fraction:0{digits}d}"
