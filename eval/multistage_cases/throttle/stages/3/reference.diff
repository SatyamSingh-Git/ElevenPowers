diff --git a/CHANGELOG.md b/CHANGELOG.md
index 069998f..3ed85c5 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -2,6 +2,7 @@
 
 ## Unreleased
 
+- Fixed: a hit costing more than the limit (a bucket's capacity) was told to retry later although it could never succeed, and crashed with IndexError on a sliding window. It now raises `ValueError: cost N exceeds limit M` and spends nothing.
 - `TokenBucket` takes `refill_period` (seconds from empty to full) instead of `refill_per_second`.
 - `Decision.retry_after` (and a snapshot's `retry_after`) is now whole milliseconds, rounded up, instead of float seconds.
 
diff --git a/docs/reference.md b/docs/reference.md
index b1166b4..01aa23f 100644
--- a/docs/reference.md
+++ b/docs/reference.md
@@ -81,6 +81,7 @@ dict per key, sorted by key, with `key`, `policy` and `retry_after` added.
 | `error.period` | `period must be positive: {value}` | ValueError. |
 | `error.refill` | `refill_period must be positive: {value}` | ValueError from TokenBucket. |
 | `error.cost` | `cost must be at least 1: {cost}` | ValueError from `hit()`. |
+| `error.cost_limit` | `cost {cost} exceeds limit {limit}` | ValueError from `hit()` and `check()`; `{limit}` is a bucket's capacity. Nothing is spent. |
 | `error.max_keys` | `max_keys must be at least 1: {value}` | ValueError from Throttle. |
 | `error.rate_limited` | `rate limit exceeded for {key}: retry in {wait}` | RateLimitExceeded from `check()`; `{wait}` as in `duration.format`. |
 | `error.config` | `config line {n}: {problem}` | ConfigError; `{problem}` may be any policy error. |
diff --git a/src/throttle/base.py b/src/throttle/base.py
index 5aca271..b198998 100644
--- a/src/throttle/base.py
+++ b/src/throttle/base.py
@@ -33,6 +33,9 @@ class Limiter:
         """Spend ``cost`` units if they are available."""
         if cost < 1:
             raise ValueError(f'cost must be at least 1: {cost}')
+        # Waiting would never help, so refuse outright rather than hand out a retry time.
+        if cost > self.limit:
+            raise ValueError(f'cost {cost} exceeds limit {self.limit}')
         return self._take(cost, consume=True)
 
     def peek(self):
diff --git a/tests/test_limiters.py b/tests/test_limiters.py
index a6e0e5d..a3e671d 100644
--- a/tests/test_limiters.py
+++ b/tests/test_limiters.py
@@ -97,3 +97,16 @@ def test_wait_is_whole_milliseconds_rounded_up():
     window = FixedWindow(1, 0.3, clock)
     window.hit()
     assert window.hit().retry_after == 300
+
+
+@pytest.mark.parametrize('make', [
+    lambda clock: FixedWindow(10, 60, clock),
+    lambda clock: SlidingWindow(10, 60, clock),
+    lambda clock: TokenBucket(10, 60, clock),
+])
+def test_cost_above_limit_is_refused_without_spending(make):
+    limiter = make(ManualClock())
+    limiter.hit(3)
+    with pytest.raises(ValueError, match='^cost 15 exceeds limit 10$'):
+        limiter.hit(15)
+    assert limiter.hit(7).allowed
