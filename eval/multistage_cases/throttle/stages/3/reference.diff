 | `error.config` | `config line {n}: {problem}` | ConfigError; `{problem}` may be any policy error. |
diff --git a/src/throttle/base.py b/src/throttle/base.py
index 5aca271..3981f08 100644
--- a/src/throttle/base.py
+++ b/src/throttle/base.py
@@ -31,8 +31,9 @@ class Limiter:
 
     def hit(self, cost=1):
         """Spend ``cost`` units if they are available."""
-        if cost < 1:
-            raise ValueError(f'cost must be at least 1: {cost}')
+        # A cost above the limit could never be allowed: refuse it rather than hand out a retry time.
+        if not 1 <= cost <= self.limit:
+            raise ValueError(f'cost must be between 1 and {self.limit}: {cost}')
         return self._take(cost, consume=True)
 
     def peek(self):
