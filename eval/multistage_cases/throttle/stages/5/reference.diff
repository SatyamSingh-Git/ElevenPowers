+
+
+def test_any_object_with_monotonic_is_a_clock():
+    class Ticks:
+        at = 50.0
+
+        def monotonic(self):
+            return self.at
+
+    ticks = Ticks()
+    window = FixedWindow(1, 10, ticks)
+    window.hit()
+    assert window.hit().retry_after == 10000
+    ticks.at = 60
+    assert window.hit().allowed
+    assert ManualClock(3).monotonic() == 3
