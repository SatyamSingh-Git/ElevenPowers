diff --git a/src/layercfg/envsource.py b/src/layercfg/envsource.py
index 976dbf5..594c36c 100644
--- a/src/layercfg/envsource.py
+++ b/src/layercfg/envsource.py
@@ -1,21 +1,29 @@
 """The environment layer.
 
 The caller passes the environment in as a mapping; nothing here reads
-os.environ. `LAYERCFG_SERVER__PORT` sets `server.port`: the prefix is dropped,
-the rest is lower-cased and the separator becomes a dot.
+os.environ. `LAYERCFG_SERVER_PORT` sets `server.port`: a variable's name is
+the prefix and then the key upper-cased, with its dot as an underscore.
+Option names contain underscores themselves, so a variable is matched against
+the names the schema knows instead of being split.
 """
 from .schema import Entry
 
 ENV_PREFIX = 'LAYERCFG_'
-SEPARATOR = '__'
 
 
-def read_env(env, prefix=ENV_PREFIX):
-    """Entries for every variable carrying the prefix, sorted by name."""
+def env_name(key, prefix=ENV_PREFIX):
+    """The variable that sets `key`."""
+    return prefix + key.upper().replace('.', '_')
+
+
+def read_env(env, schema, prefix=ENV_PREFIX):
+    """Entries for every variable carrying the prefix, sorted by name.
+
+    A variable that names no option gets an empty key, which no schema resolves.
+    """
+    known = {env_name(name, prefix): name for name in schema.names()}
     entries = []
     for name in sorted(env):
-        if not name.startswith(prefix) or name == prefix:
-            continue
-        key = name[len(prefix):].lower().replace(SEPARATOR, '.')
-        entries.append(Entry(key, env[name], f'env {name}', 'env'))
+        if name.startswith(prefix) and name != prefix:
+            entries.append(Entry(known.get(name, ''), env[name], f'env {name}', 'env'))
     return entries
