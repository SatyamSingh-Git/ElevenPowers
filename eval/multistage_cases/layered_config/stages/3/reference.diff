diff --git a/src/layercfg/loader.py b/src/layercfg/loader.py
index 7167bc6..5ce5fe0 100644
--- a/src/layercfg/loader.py
+++ b/src/layercfg/loader.py
@@ -79,16 +79,18 @@ def _apply(schema, entries, values, sources):
     return issues
 
 
-def load(file_text=None, env=None, *, file_name='config.ini', schema=APP_SCHEMA, env_prefix=ENV_PREFIX):
-    """Defaults, then the file, then the environment; later layers win.
+def load(files=(), env=None, *, schema=APP_SCHEMA, env_prefix=ENV_PREFIX):
+    """Defaults, then each file in order, then the environment; later layers win.
 
-    Every problem in every layer is collected and raised together as one
-    ValidationError. A file that is not valid INI raises ParseError.
+    `files` is a sequence of `(name, text)` pairs; the name is what sources
+    and messages call the file. Every problem in every layer is collected and
+    raised together as one ValidationError. A file that is not valid INI
+    raises ParseError.
     """
     values, sources = _defaults(schema)
     entries = []
-    if file_text is not None:
-        entries += parse(file_text, file_name)
+    for name, text in files:
+        entries += parse(text, name)
     if env:
         entries += read_env(env, schema, env_prefix)
     issues = _apply(schema, entries, values, sources)
