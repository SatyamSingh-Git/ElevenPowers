diff --git a/src/layercfg/errors.py b/src/layercfg/errors.py
index 077babc..4c276bc 100644
--- a/src/layercfg/errors.py
+++ b/src/layercfg/errors.py
@@ -19,6 +19,22 @@ class ParseError(ConfigError):
         self.message = message
 
 
+class UnknownKeyError(ConfigError, KeyError):
+    """A lookup named no option and no alias."""
+
+    def __init__(self, key, suggestion=None):
+        message = f"unknown key '{key}'"
+        if suggestion:
+            message += f" (did you mean '{suggestion}'?)"
+        super().__init__(message)
+        self.key = key
+        self.suggestion = suggestion
+
+    # KeyError would print the message quoted, as if it were the key.
+    def __str__(self):
+        return self.args[0]
+
+
 @dataclass(frozen=True)
 class Issue:
     source: str
