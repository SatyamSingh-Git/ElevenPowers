 """The options the application understands."""
 from .schema import Option, Schema
 
+
+def _pool_order(values):
+    if values['pool.min_size'] > values['pool.max_size']:
+        yield 'pool.min_size', 'pool.min_size: must not exceed pool.max_size'
+
+
+def _tls_pair(values):
+    cert, key = values['server.tls_cert'], values['server.tls_key']
+    if (cert is None) != (key is None):
+        yield ('server.tls_key' if cert is None else 'server.tls_cert',
+               'server.tls_cert and server.tls_key must be set together')
+
+
 APP_SCHEMA = Schema([
