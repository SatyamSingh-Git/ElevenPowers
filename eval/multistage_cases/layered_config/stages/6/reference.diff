+def test_pool_minimum_must_not_exceed_maximum():
+    with pytest.raises(ValidationError) as caught:
+        load([('app.ini', '[pool]\nmin_size = 5\n')], {'LAYERCFG_POOL_MAX_SIZE': '3'})
+    assert str(caught.value) == 'app.ini line 2: pool.min_size: must not exceed pool.max_size'
+    assert load([('app.ini', '[pool]\nmin_size = 3\nmax_size = 3\n')])['pool.min_size'] == 3
+
+
+def test_tls_certificate_and_key_go_together():
+    with pytest.raises(ValidationError) as caught:
+        load(env={'LAYERCFG_SERVER_TLS_KEY': '/k.pem'})
+    assert str(caught.value) == 'env LAYERCFG_SERVER_TLS_KEY: server.tls_cert and server.tls_key must be set together'
+    with pytest.raises(ValidationError) as caught:
+        load([('app.ini', '[server]\ntls_cert = /c.pem\n')])
+    assert str(caught.value) == 'app.ini line 2: server.tls_cert and server.tls_key must be set together'
+    config = load([('app.ini', '[server]\ntls_cert = /c.pem\ntls_key = /k.pem\n')])
+    assert config['server.tls_key'] == '/k.pem'
+
+
+def test_rules_wait_for_valid_values():
+    with pytest.raises(ValidationError) as caught:
+        load([('app.ini', '[pool]\nmin_size = 50\nmax_size = 5000\n')])
+    assert [str(issue) for issue in caught.value.issues] == ['app.ini line 3: pool.max_size: must be at most 1000']
+
+
 def test_schema_refuses_clashing_names():
