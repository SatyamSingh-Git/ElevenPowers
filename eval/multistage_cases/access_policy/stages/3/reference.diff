+
+def test_numbers_compare_as_numbers():
+    assert holds("user.clearance >= 3", {"clearance": 10})
+    assert holds("user.clearance >= 3", {"clearance": "10"})
+    assert not holds("user.clearance >= 3", {"clearance": 2})
+    assert holds("user.level < resource.level", {"level": 9}, {"level": "10"})
+    assert holds("user.level == 3", {"level": "3.0"})
+
+
+def test_non_numbers_still_compare_as_text():
+    assert holds('user.name < "m"', {"name": "alice"})
+    assert not holds('user.name < "m"', {"name": "zed"})
+    assert holds('user.code > 5', {"code": "a1"})
