diff --git a/src/warden/conditions.py b/src/warden/conditions.py
index b05687e..1c18795 100644
--- a/src/warden/conditions.py
+++ b/src/warden/conditions.py
@@ -48,9 +48,22 @@ class Clause:
         left, right = self.left.value(scope), self.right.value(scope)
         if left is MISSING or right is MISSING:
             return False
+        numbers = _number(left), _number(right)
+        if None not in numbers:
+            return OPERATORS[self.op](*numbers)
         return OPERATORS[self.op](_text(left), _text(right))
 
 
+def _number(value):
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, (int, float)):
+        return value
+    if isinstance(value, str) and _NUMBER.fullmatch(value.strip()):
+        return float(value)
+    return None
+
+
 def _text(value):
     if isinstance(value, bool):
         return "true" if value else "false"
