{
 "0": {
  "syntax.comment": "#",
  "syntax.role": "role <name> [inherits <parent>]",
  "syntax.rule": "<effect> <role> <actions> <pattern> [when <condition>]",
  "syntax.default": "default <effect>",
  "syntax.actions_separator": ",",
  "effects": "allow, deny",
  "default_effect": "deny",
  "precedence": "deny-overrides",
  "role.name": "[A-Za-z][A-Za-z0-9_-]*",
  "limit.inheritance_chain": "8",
  "action.names": "read, list, write, delete, share, admin",
  "action.any": "*",
  "action.aliases": "view, get: read; ls: list; edit, put: write; remove, rm: delete",
  "action.case": "insensitive",
  "pattern.separator": "/",
  "pattern.segment_wildcard": "*",
  "pattern.deep_wildcard": "**",
  "pattern.normalize": "empty segments dropped",
  "condition.namespaces": "user, resource",
  "condition.operators": "== != < <= > >=",
  "condition.join": "and",
  "condition.literals": "\"text\", numbers, true, false",
  "condition.compare": "text",
  "condition.missing": "false",
  "dict.schema": "3",
  "dict.rule_fields": "effect, role, actions, resource, when",
  "dict.required": "effect, role, actions, resource",
  "file.json_suffix": ".json",
  "decision.fields": "request, allowed, reason, rule, near_misses, roles",
  "reason.allow": "allowed by rule {number}",
  "reason.deny": "denied by rule {number}",
  "reason.default": "no rule matched; default is {effect}",
  "rule.numbering": "1-based, in policy order",
  "near_misses": "rules whose condition did not hold",
  "explain.header": "{verdict} {user} {action} {resource}: {reason}",
  "explain.verdicts": "ALLOW, DENY",
  "explain.rule": "  rule {number} (line {line}): {rule}",
  "explain.skipped": "  rule {number} not applied: {clauses}",
  "log.format": "JSON lines, keys sorted",
  "log.mode": "append",
  "log.fields": "action, allowed, reason, resource, rule, user",
  "log.rule": "rule number or null",
  "report.header": "{total} decisions: {allowed} allowed, {denied} denied",
  "report.user_line": "{user}  {allowed} allowed  {denied} denied",
  "report.top": "5",
  "lint.unused-role": "role {role} is never used",
  "lint.redundant-role": "role {role} adds nothing to {parent}",
  "lint.shadowed-rule": "rule {number} can never apply: rule {other} denies it",
  "lint.duplicate-rule": "rule {number} repeats rule {other}",
  "cli.check_exit": "0 allowed, 1 denied, 2 error",
  "cli.lint_exit": "0 clean, 1 findings, 2 error",
  "error.line": "line {line}: {message}",
  "error.dict_rule": "rule {number}: {message}",
  "error.unknown_role": "unknown role: {name}",
  "error.duplicate_role": "role {name} is defined twice",
  "error.bad_role_name": "bad role name: {name}",
  "error.role_cycle": "role cycle: {a} -> {b} -> {a}",
  "error.inheritance_chain": "inheritance chain of {name} is longer than 8 roles",
  "error.unknown_action": "unknown action: {action}",
  "error.unknown_effect": "unknown effect: {effect}",
  "error.bad_pattern": "bad pattern: {pattern}",
  "error.rule_shape": "expected: {rule syntax}",
  "error.role_shape": "expected: {role syntax}",
  "error.bad_condition": "bad condition: {condition}",
  "error.bad_operand": "bad operand: {operand}",
  "error.namespace": "unknown attribute namespace: {namespace}",
  "error.missing_field": "missing field: {field}",
  "error.schema": "unsupported schema: {schema}"
 },
