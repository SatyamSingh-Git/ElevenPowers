+def test_transfer_within_one_location_is_refused(inventory):
+    inventory.receive('BOLT-M6', 10, 'A1')
+    with pytest.raises(StockError, match='cannot transfer within one location: A1'):
+        inventory.transfer('BOLT-M6', 5, 'A1', 'a1')
+    assert inventory.at('BOLT-M6', 'A1') == 10
+    assert len(inventory.doc['movements']) == 1
