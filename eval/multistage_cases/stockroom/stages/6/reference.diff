diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index e1d1c76..f9d978e 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -73,5 +73,27 @@ def test_transfer_within_one_location_is_refused(inventory):
     assert len(inventory.doc['movements']) == 1
 
 
+def test_capacity_counts_every_item_at_the_location(inventory):
+    inventory.add_location('C3', capacity=10)
+    inventory.receive('BOLT-M6', 6, 'C3')
+    inventory.receive('NUT-M6', 4, 'C3')
+    with pytest.raises(StockError, match='location C3 is full: capacity 10, would hold 11'):
+        inventory.receive('NUT-M6', 1, 'C3')
+    inventory.receive('BOLT-M6', 3, 'A1')
+    with pytest.raises(StockError, match='location C3 is full: capacity 10, would hold 13'):
+        inventory.transfer('BOLT-M6', 3, 'A1', 'C3')
+    assert inventory.at('BOLT-M6', 'A1') == 3
+    inventory.issue('NUT-M6', 4, 'C3')
+    inventory.transfer('BOLT-M6', 3, 'A1', 'C3')
+    assert inventory.at('BOLT-M6', 'C3') == 9
+
+
+def test_locations_without_capacity_are_unlimited(inventory):
+    assert inventory.location('A1')['capacity'] is None
+    inventory.receive('BOLT-M6', 1_000_000, 'A1')
+    with pytest.raises(StockError, match='capacity must be a whole number from 1 to 1000000: 0'):
+        inventory.add_location('D4', capacity='0')
+
+
 def test_items_keep_their_cost(inventory):
     assert inventory.item('BOLT-M6')['cost_cents'] == 12
