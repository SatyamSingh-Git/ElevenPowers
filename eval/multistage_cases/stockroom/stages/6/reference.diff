     return point
 
 
+def parse_capacity(value):
+    """A location's capacity in units of any item, or None for no limit."""
+    if value is None:
+        return None
+    capacity = _whole(value)
+    if capacity is None or not 1 <= capacity <= MAX_QTY:
+        raise StockError(f'capacity must be a whole number from 1 to {MAX_QTY}: {value}')
+    return capacity
+
+
 def parse_money(value):
     """Dollars and cents such as '2.50', '3' or '$0.12', as a whole number of cents."""
