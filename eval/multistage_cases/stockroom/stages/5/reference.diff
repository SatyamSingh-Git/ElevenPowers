@@ -32,8 +32,25 @@ def _from_v1(doc):
     return doc
 
 
+def _from_v2(doc):
+    lines = []
+    for movement in doc['movements']:
+        qty, kind = movement['qty'], movement['type']
+        if kind == 'transfer':
+            changes = [(movement['from'], -qty), (movement['to'], qty)]
+        elif kind == 'issue':
+            changes = [(movement['from'], -qty)]
+        else:
+            changes = [(movement['to'], qty)]
+        lines += [{'seq': movement['seq'], 'type': kind, 'sku': movement['sku'], 'location': code,
+                   'delta': delta, 'note': movement['note']} for code, delta in changes]
+    doc['movements'] = lines
+    doc['version'] = 3
+    return doc
+
+
 # version: the step that rewrites a document of that version as the next one
