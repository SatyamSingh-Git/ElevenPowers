-"""Offset index: one fixed-size entry per record, mapping offset to file position.
+"""Sparse offset index: fixed-size entries mapping offset to file position.
 
-    offset    u64
-    position  u32   byte position of the record in its segment file
+    relative_offset  u32   offset minus the segment's base offset
+    position         u32   byte position of the record in its segment file
+
+The first record of a segment always gets an entry; after that a record gets
+one only when it starts at least `index_interval_bytes` after the previous
+entry's position. Readers seek to the nearest entry and scan forward.
 """
 from bisect import bisect_right
 from pathlib import Path
 import struct
 
-ENTRY = struct.Struct('>QI')
+ENTRY = struct.Struct('>II')
 
 
 class IndexWriter:
-    def __init__(self, path):
+    def __init__(self, path, base_offset, interval_bytes):
         self.path = Path(path)
+        self.base_offset = base_offset
+        self.interval_bytes = interval_bytes
+        entries = read_entries(self.path, base_offset)
+        self._last_position = entries[-1][1] if entries else None
         self._file = open(self.path, 'ab')
 
     def add(self, offset, position):
-        self._file.write(ENTRY.pack(offset, position))
+        if self._last_position is not None and position - self._last_position < self.interval_bytes:
+            return
+        self._file.write(ENTRY.pack(offset - self.base_offset, position))
         self._file.flush()
+        self._last_position = position
 
     def close(self):
         self._file.close()
 
 
-def read_entries(path):
-    """The (offset, position) pairs in an index file, oldest first."""
+def read_entries(path, base_offset):
+    """The (offset, position) pairs in an index file, oldest first, with absolute offsets."""
     path = Path(path)
     data = path.read_bytes() if path.exists() else b''
     # A crash can leave half an entry at the end; it describes nothing yet.
     usable = len(data) - len(data) % ENTRY.size
-    return [ENTRY.unpack_from(data, at) for at in range(0, usable, ENTRY.size)]
+    return [(base_offset + relative, position)
+            for relative, position in (ENTRY.unpack_from(data, at) for at in range(0, usable, ENTRY.size))]
 
 
 def lookup(entries, offset):
@@ -38,6 +50,10 @@ def lookup(entries, offset):
     return entries[at - 1][1] if at else None
 
 
-def rebuild(segment, found):
+def rebuild(segment, found, interval_bytes):
     """Rewrite a segment's index from the (position, record) pairs a scan found."""
-    segment.index_path.write_bytes(b''.join(ENTRY.pack(record.offset, position) for position, record in found))
+    segment.index_path.write_bytes(b'')
+    writer = IndexWriter(segment.index_path, segment.base_offset, interval_bytes)
+    for position, record in found:
+        writer.add(record.offset, position)
+    writer.close()
