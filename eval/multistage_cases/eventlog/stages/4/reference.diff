+def test_segments_never_exceed_segment_bytes(tmp_path):
+    with Log.open(tmp_path, LogConfig(segment_bytes=100)) as log:
+        for n in range(30):
+            log.append(f'k{n}', 'v' * (n % 9))
+        assert [r.offset for r in log.replay()] == list(range(30))
+    sizes = [path.stat().st_size for path in segment_files(tmp_path)]
+    assert len(sizes) > 3
+    assert max(sizes) <= 100
+
+
+def test_record_too_large_for_any_segment(tmp_path):
+    with Log.open(tmp_path, LogConfig(segment_bytes=64)) as log:
+        log.append('k', 'v')
+        with pytest.raises(RecordTooLarge, match='^record of 75 bytes exceeds segment_bytes 64$'):
+            log.append('k', 'v' * 50)
+        assert log.next_offset == 1
+        assert log.append('k', 'w') == 1
+    assert max(path.stat().st_size for path in segment_files(tmp_path)) <= 64
+
