+def binary_size(size):
+    """`512 B`, `1.5 KiB`, `3.0 MiB`: whole bytes below 1 KiB, one decimal above."""
+    if size < 1024:
+        return f'{size} B'
+    for unit in ('KiB', 'MiB', 'GiB'):
+        size /= 1024
+        if size < 1024 or unit == 'GiB':
+            return f'{size:.1f} {unit}'
 
 
