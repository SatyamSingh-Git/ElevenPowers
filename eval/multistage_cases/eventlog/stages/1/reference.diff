@@ -2,15 +2,17 @@
 
 A record on disk is a length prefix followed by the body it counts:
 
-    length     u32   bytes that follow the length field
-    crc        u32   CRC-32C of everything after this field
+    length     uvarint  bytes that follow the length field
+    crc        u32      CRC-32C of everything after this field
     offset     u64
-    timestamp  u64   milliseconds
-    flags      u8    bit 0 marks a tombstone
+    timestamp  u64      milliseconds
+    flags      u8       bit 0 marks a tombstone
     key_length u16
-    key, value       the value takes whatever the length leaves
+    key, value          the value takes whatever the length leaves
 
-All integers are big-endian.
+The length is an unsigned LEB128 varint: seven bits per byte, low-order group
+first, the high bit set on every byte but the last. Every other integer is
+big-endian.
 """
 from dataclasses import dataclass
 import struct
@@ -19,7 +21,6 @@ from ._generated import CRC32C_TABLE
 from .errors import CorruptRecord
 
 TOMBSTONE = 0x01
