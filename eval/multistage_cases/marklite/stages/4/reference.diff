+def test_deep_nesting_is_an_error_not_a_crash():
+    with pytest.raises(MarkliteError) as raised:
+        render("text\n\n" + ">" * 5000 + " deep\n")
+    assert str(raised.value) == "line 3: nesting deeper than 32 levels"
