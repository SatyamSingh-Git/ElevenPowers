--- a/tests/test_inline.py
+++ b/tests/test_inline.py
@@ -15,6 +15,15 @@ def test_nested_emphasis():
     assert inline("**bold *and* more**") == "<strong>bold <em>and</em> more</strong>"
 
 
+def test_strikethrough():
+    assert inline("~~gone~~ ~~**old**~~ **~~both~~**") == (
+        "<del>gone</del> <del><strong>old</strong></del> <strong><del>both</del></strong>")
+
+
+def test_single_tildes_are_literal():
+    assert inline("~5 km ~~ ~~~x~~~ ~~open") == "~5 km ~~ ~~~x~~~ ~~open"
+
+
 def test_underscores_inside_words_are_literal():
     assert inline("snake_case_name") == "snake_case_name"
 
