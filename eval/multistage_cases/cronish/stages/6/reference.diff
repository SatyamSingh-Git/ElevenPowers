+def _step(values, spec):
+    """The interval of values that step evenly through the whole field from its start, else None."""
+    if len(values) < 2:
+        return None
+    step = values[1] - values[0]
+    if step > 1 and spec.size % step == 0 and values == tuple(range(spec.low, spec.high + 1, step)):
+        return step
+    return None
+
+
 def _numbered(unit, values):
     label = unit if len(values) == 1 else unit + "s"
     return f"{label} {join_words(str(value) for value in values)}"
