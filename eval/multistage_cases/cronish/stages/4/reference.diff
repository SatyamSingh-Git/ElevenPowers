 """Checking an expression before it is saved or scheduled."""
 from ._generated import MONTH_LENGTHS
 from .errors import ScheduleError
-from .expression import parse
+from .expression import expand, parse
+from .fields import FIELDS, parse_field
 
 
 def validate(text):
-    """Messages describing what is wrong with `text`; empty when it is usable."""
+    """Every problem with `text` as ``(field, message)`` pairs; empty when it is usable."""
     try:
-        schedule = parse(text)
+        parts = expand(text)
     except ScheduleError as error:
-        return [str(error)]
-    problem = _impossible_day(schedule)
-    return [str(problem)] if problem else []
+        return [(error.field, error.problem)]
+    problems = []
+    for part, spec in zip(parts, FIELDS):
+        try:
+            parse_field(part, spec)
+        except ScheduleError as error:
+            problems.append((error.field, error.problem))
+    if problems:
+        return problems
+    problem = _impossible_day(parse(text))
+    return [(problem.field, problem.problem)] if problem else []
 
 
