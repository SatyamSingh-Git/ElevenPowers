@@ -54,15 +54,18 @@ def normalize_region(code):
     return region
 
 
-def rate_for(category, region):
-    """Percent charged on `category` in `region`: the latest rate listed."""
-    history = RATES[normalize_region(region)][category]
-    return Decimal(history[-1][1])
+def rate_for(category, region, *, on):
+    """Percent charged on `category` in `region` on the date `on`, YYYY-MM-DD."""
+    region = normalize_region(region)
+    in_force = [rate for since, rate in RATES[region][category] if since <= on]
+    if not in_force:
+        raise TaxError(f"no {category} rate for {region} on {on}")
+    return Decimal(in_force[-1])
 
 
 def format_rate(rate):
     return f"{rate.normalize():f}%"
 
 
-def line_tax(net, category, region, currency, rounding):
-    return quantize(net * rate_for(category, region) / 100, currency, rounding)
+def line_tax(net, category, region, currency, rounding, *, on):
+    return quantize(net * rate_for(category, region, on=on) / 100, currency, rounding)
