diff --git a/tests/test_render.py b/tests/test_render.py
index 57f02fc..ff0b9a8 100644
--- a/tests/test_render.py
+++ b/tests/test_render.py
@@ -52,3 +52,18 @@ def test_render_negatives_with_a_minus_sign():
 def test_render_negatives_must_be_known():
     with pytest.raises(ValueError, match="negatives must be parentheses or minus"):
         render_text(invoice_from_dict(INVOICE), negatives="red")
+
+
+def test_render_notes_under_the_totals():
+    notes = "Payment due within 30 days. " * 6 + "\nThank you for your business."
+    lines = render_text(invoice_from_dict({**INVOICE, "notes": notes}), width=60).splitlines()
+    start = lines.index("Notes:")
+    assert lines[start - 2].startswith("Total")
+    body = lines[start + 1:]
+    assert all(len(line) <= 60 for line in body)
+    assert " ".join(body).split() == notes.split()
+    assert body[-1] == "Thank you for your business."
+
+
+def test_render_without_notes_ends_with_the_total():
+    assert render_text(invoice_from_dict(INVOICE)).splitlines()[-1].startswith("Total")
