diff --git a/src/invoicekit/render.py b/src/invoicekit/render.py
index ce1769c..9ee64c9 100644
--- a/src/invoicekit/render.py
+++ b/src/invoicekit/render.py
@@ -1,3 +1,4 @@
+import textwrap
 from decimal import Decimal
 
 from .invoice import compute
@@ -67,4 +68,8 @@ def render_text(invoice, width=DEFAULT_WIDTH, negatives="parentheses"):
     for rate, base, tax in _tax_summary(invoice, totals):
         out.append(_row(f"Tax {format_rate(rate)} on {money(base)}", money(tax), width))
     out.append(_row("Total", money(totals.total), width))
+    if invoice.notes:
+        out += ["", "Notes:"]
+        for paragraph in invoice.notes.splitlines():
+            out += textwrap.wrap(paragraph, width) or [""]
     return "\n".join(out) + "\n"
