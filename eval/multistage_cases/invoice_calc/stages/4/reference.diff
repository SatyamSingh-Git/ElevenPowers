diff --git a/src/invoicekit/money.py b/src/invoicekit/money.py
index d2fc86c..8f051cd 100644
--- a/src/invoicekit/money.py
+++ b/src/invoicekit/money.py
@@ -61,3 +61,12 @@ def format_money(amount, currency):
     amount = quantize(amount, currency)
     sign = "-" if amount < 0 else ""
     return f"{sign}{symbol}{abs(amount):,.{places}f}"
+
+
+def to_minor_units(amount, currency):
+    """1234 for $12.34; the amount must already be rounded to the currency."""
+    return int(amount.scaleb(minor_units(currency)))
+
+
+def from_minor_units(units, currency):
+    return Decimal(units).scaleb(-minor_units(currency))
