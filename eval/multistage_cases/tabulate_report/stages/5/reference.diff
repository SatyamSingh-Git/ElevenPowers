@@ -12,6 +12,8 @@ def parse_amount(text, thousands=","):
     """The Decimal in a cell such as ``1,234.50``, ``-$12``, ``(7.25)`` or ``CHF 3``.
 
     Parentheses mean a negative amount, as accounting exports write them.
+    A ``thousands`` separator is accepted only between groups of three digits
+    of the whole part, so a typo such as ``12,34`` is refused, not read as 1234.
     """
     cleaned = text.strip()
     sign = 1
@@ -25,7 +27,8 @@ def parse_amount(text, thousands=","):
         if cleaned.startswith(symbol):
             cleaned = cleaned[len(symbol):].lstrip()
             break
-    if thousands:
+    if thousands and thousands in cleaned:
+        _check_grouping(cleaned, thousands, text)
         cleaned = cleaned.replace(thousands, "")
     try:
         value = Decimal(cleaned)
@@ -36,6 +39,14 @@ def parse_amount(text, thousands=","):
     return sign * value
 
 
+def _check_grouping(cleaned, thousands, text):
+    whole = cleaned if thousands == "." else cleaned.partition(".")[0]
+    groups = whole.split(thousands)
+    if (thousands in cleaned[len(whole):] or not 1 <= len(groups[0]) <= 3
+            or any(len(group) != 3 for group in groups[1:])):
+        raise ReportError(f"misplaced thousands separator: {text!r}")
+
+
 def format_number(value, places=2, thousands=","):
     """``value`` rounded half up to ``places`` decimals, digits grouped by ``thousands``."""
     rounded = Decimal(value).quantize(Decimal(1).scaleb(-places), rounding=ROUND_HALF_UP)
