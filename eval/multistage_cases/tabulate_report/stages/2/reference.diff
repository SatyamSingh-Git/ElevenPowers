+def test_numeric_keys_stay_left_aligned():
+    rows = [{"store": "7", "v": "1"}, {"store": "0042", "v": "2"}, {"store": "123", "v": "3"}]
+    lines = render_report(build_report(rows, ["store"], ["sum:v"], totals=False)).splitlines()
+    assert lines[2:5] == ["0042    $2.00", "123     $3.00", "7       $1.00"]
+    rule = render_report(build_report(rows, ["store"], ["sum:v"]), "markdown").splitlines()[1]
+    assert rule == "| ----- | -----: |"
+
+
 def test_sort_by_measure_descending(sales):
     report = build_report(read_csv(sales), ["region"], ["sum:amount"], sort="-sum(amount)")
     assert [row[0] for row in report.rows] == ["East", "North", "West"]
