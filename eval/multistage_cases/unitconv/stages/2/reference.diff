--- a/src/unitconv/errors.py
+++ b/src/unitconv/errors.py
@@ -3,9 +3,15 @@ class UnitError(ValueError):
 
 
 class UnknownUnitError(UnitError):
-    def __init__(self, symbol):
-        super().__init__(f"unknown unit: '{symbol}'")
+    def __init__(self, symbol, candidates=()):
+        message = f"unknown unit: '{symbol}'"
+        if candidates:
+            quoted = [f"'{candidate}'" for candidate in candidates]
+            listed = quoted[0] if len(quoted) == 1 else ', '.join(quoted[:-1]) + ' or ' + quoted[-1]
+            message += f' (did you mean {listed}?)'
+        super().__init__(message)
         self.symbol = symbol
+        self.candidates = tuple(candidates)
 
 
 class IncompatibleUnitsError(UnitError):
